        "review_NTGRJx": {
          "type": "review",
          "name": "Review",
          "settings": {
            "name": "Julianna",
            "location": "Miami, FL",
            "meta_type": "subscriber",
            "duration": "",
            "photo": "shopify://shop_images/image_1926988520_1.jpg",
            "rating": 5,
            "quote": "I spend long hours in front of a computer, so I always keep these eye drops with me. The formula feels very soothing, and they quickly help relieve the dryness and discomfort I get after staring at a screen all day.",
            "tags": "verified,lens_wearer,screen_worker"
          }
        },
        "review_7yHe78": {
          "type": "review",
          "name": "Review",
          "settings": {
            "name": "Charity",
            "location": "Los Angeles, CA",
            "meta_type": "subscriber",
            "duration": "",
            "photo": "shopify://shop_images/image_1926988520_2.jpg",
            "rating": 5,
            "quote": "From the first time I used Moisture Oyster, my eyes felt so much better. I’d been relying on Lumify for a long time because my eyes were always red, but after using these drops, I found myself reaching for Lumify less and less. I also love that they don’t sting or burn like Systane does for me. I had tried BioTears before, but it just didn’t feel as moisturizing. These are honestly the best eye drops I’ve used.",
            "tags": "verified,most_helpful"
          }
        },
        "review_af7qK9": {
          "type": "review",
          "name": "Review",
          "settings": {
            "name": "Polina",
            "location": "Irvine, CA",
            "meta_type": "subscriber",
            "duration": "",
            "photo": "shopify://shop_images/image_1926988520_3.jpg",
            "rating": 5,
            "quote": "The other night I was watching TV really late, and my eyes started stinging. Like I always do, I reached for my boyfriend’s contact lens solution (odd, I know but it’s just saline!) but I kept putting it in my eyes and it really wasn’t helping. Then I remembered I had Moisture Oyster on my desk, and after just one drop, my eyes felt so much better. I haven’t reached for the contact solution since. Don’t judge me!",
            "tags": "verified,screen_worker,most_helpful"
          }
        },
        "review_jUPzaD": {
          "type": "review",
          "disabled": true,
          "settings": {
            "name": "Igor",
            "location": "",
            "meta_type": "subscriber",
            "duration": "",
            "photo": "shopify://shop_images/image_1926988520_2.jpg",
            "rating": 5,
            "quote": "Very gentle formula I really like how it feels on my eyes. At first, the application felt a little unusual, then I realized I'd only ever used eye drops with preservatives before. Now it makes perfect sense.",
            "tags": "verified"
          }
        }
      },
