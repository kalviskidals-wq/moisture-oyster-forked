    "custom_faq_mopdp1": {
      "type": "custom-faq",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "Can I use Moisture Oyster with contact lenses?",
            "answer": "<p>It is not a rewetting drop, so don't apply it while your lenses are in. Otherwise, yes. Use it before inserting your lenses and after removing them. </p>",
            "open_by_default": false
          }
        },
        "faq_2": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "How does the preservative-free, multi-dose bottle work?",
            "answer": "<p>Our bottle uses the Aptar OSD (Ophthalmic Squeeze Dispenser), a one-way valve system that keeps every drop sterile without chemical preservatives, about 200 drops per bottle. </p>",
            "open_by_default": false
          }
        },
        "faq_3": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "Will my subscription price ever increase?",
            "answer": "<p>Your price is locked at sign-up. We never increase subscription prices without 30 days' notice and an opt-out window.</p>",
            "open_by_default": false
          }
        },
        "faq_4": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "What if I forget a delivery is coming?",
            "answer": "<p>You can skip, delay, or adjust before it ships.</p>",
            "open_by_default": false
          }
        },
        "faq_5": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "What if I use it up too slowly?",
            "answer": "<p>Switch to 60-day delivery from your account dashboard. Change frequency anytime, no fees.</p>",
            "open_by_default": false
          }
        },
        "faq_6": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "How do I pause or cancel?",
            "answer": "<p>One tap in your account dashboard. No forms, no phone calls.</p>",
            "open_by_default": false
          }
        },
        "faq_7": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "Is Moisture Oyster safe for daily use?",
            "answer": "<p>Yes. BAK-free, preservative-free, and independently tested as non-irritant under OECD TG 492B. Follow the directions on the Drug Facts panel.</p>",
            "open_by_default": false
          }
        },
        "faq_8": {
          "type": "faq",
          "name": "FAQ",
          "settings": {
            "question": "Where is Moisture Oyster made?",
            "answer": "<p>Manufactured in the Netherlands by Oté Pharma SOL B.V. according to US FDA 21 CFR 210 & 211 cGMP standards.</p>",
            "open_by_default": false
          }
        }
      },
