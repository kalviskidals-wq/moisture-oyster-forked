{%- # CUSTOM: net-new snippet — small inline line-art SVG set for MO About Us provenance icons (dropper, palm tree, GMP seal). Used as the fallback when a block has no uploaded icon image, so the icon color token (currentColor) can tint it. Same ring-baked-in/currentColor convention as mo-benefit-icon.liquid / mo-factor-icon.liquid / mo-step-icon.liquid / mo-subscribe-icon.liquid. UPSTREAM risk LOW — no Horizon file touched. -%}
{%- # Params: icon (string preset key) -%}
{%- liquid
  assign icon = icon | default: 'none'
-%}
{%- case icon -%}
  {%- when 'dropper' -%}
    {%- # Made in the Netherlands — pipette/dropper, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M20 11H28" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M22 11V22.5L15 33C14 34.7 15.2 37 17.2 37H30.8C32.8 37 34 34.7 33 33L26 22.5V11" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M18.5 29H29.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'palm_tree' -%}
    {%- # Designed in Miami — palm tree, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M24 20V37" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M24 20C24 20 24 12 30 11C34 10.3 35 14 32 15.5C29.5 16.7 24 20 24 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M24 20C24 20 24 13.5 18.5 12C14.8 11 13.5 14.5 16.5 16C19 17.2 24 20 24 20Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M24 17C24 17 26.5 11.5 31.5 12.5C35 13.2 34.3 17 31 17.3C28 17.6 24 17 24 17Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M21 37L19 33" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M27 37L29 33" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'gmp' -%}
    {%- # US FDA cGMP Standards — certification seal (checkmark + ribbon tails), ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <circle cx="24" cy="20" r="9" stroke="currentColor" stroke-width="1.6"/>
      <path d="M20 20L23 23L28.5 16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M19 27.5L16.5 37L24 33L31.5 37L29 27.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
