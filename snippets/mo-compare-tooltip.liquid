{% doc %}
  Renders a small outlined "i" info-icon trigger + tooltip for the MO
  Comparison Table. Pure CSS hover/focus reveal — no Popover API, no CSS
  anchor positioning, no JS. The tooltip text is a normal absolutely-
  positioned child of its own trigger wrapper, so it always renders exactly
  next to its icon in every browser (including the Shopify theme editor's
  preview iframe). An earlier version used Horizon's native
  `anchored-popover-component`, but promoting the popover to the browser's
  top layer combined with CSS anchor-positioning turned out unreliable here —
  see the moisture-oyster-project memory, 2026-07-09 round 3 notes.

  @param {string} id - Unique id for this tooltip instance (must be unique per page)
  @param {string} text - Tooltip body text
  @param {string} [label] - Accessible label for the trigger button (defaults to "More information")

  @example
  {% render 'mo-compare-tooltip', id: 'MoCompareTip-abc-mo', text: block.settings.mo_tooltip_text, label: 'More info: Preservative System, Moisture Oyster' %}
{% enddoc %}

{%- liquid
  assign id = id | default: 'MoCompareTip'
  assign text = text | default: blank
  assign label = label | default: 'More information'
-%}

{%- if text != blank -%}
  <span class="mo-compare__tooltip">
    <button
      type="button"
      class="mo-compare__tooltip-trigger button-unstyled"
      aria-label="{{ label | escape }}"
      aria-describedby="{{ id }}-tip"
    >
      {%- render 'mo-compare-icons', icon: 'info' -%}
    </button>
    <span id="{{ id }}-tip" class="mo-compare__tooltip-popover" role="tooltip">
      {{- text | escape -}}
    </span>
  </span>
{%- endif -%}
