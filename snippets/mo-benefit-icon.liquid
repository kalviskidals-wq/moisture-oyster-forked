{%- # CUSTOM: net-new snippet — small inline line-art SVG set for MO Trust Bar benefit icons. Used as the fallback when a block has no uploaded icon image, so the icon color token (--mo-trustbar-icon / currentColor) can tint it. UPSTREAM risk LOW — no Horizon file touched. -%}
{%- # Params: icon (string preset key) -%}
{%- liquid
  assign icon = icon | default: 'none'
-%}
{%- case icon -%}
  {%- when 'dropper_slash' -%}
    {%- # Preservative free — dropper with a slash through it -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M9.5 3.5L14.5 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M8 5L16 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M12 5V10.5L15.5 16C16.5 17.7 15.3 20 13.3 20H10.7C8.7 20 7.5 17.7 8.5 16L12 10.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M4.5 4.5L19.5 19.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'test_tube' -%}
    {%- # BAK free — test tube / pipette -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M9 3H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M10 3.5V15.5C10 17.4 11.6 19 13.5 19C15.4 19 17 17.4 17 15.5C17 15.5 17 15.5 17 15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M10 14H7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="13.5" cy="16.5" r="0.75" fill="currentColor"/>
      <path d="M17.5 3.5L20.5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'water_drops' -%}
    {%- # ~200 drop bottle — two overlapping droplets -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M9 4C9 4 5.5 8.6 5.5 11.5C5.5 13.6 7.1 15 9 15C10.9 15 12.5 13.6 12.5 11.5C12.5 8.6 9 4 9 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M15.5 9C15.5 9 13 12.4 13 14.5C13 16.2 14.1 17.5 15.5 17.5C16.9 17.5 18 16.2 18 14.5C18 12.4 15.5 9 15.5 9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'hand_drop' -%}
    {%- # GLP tested — dropper releasing a drop above an open palm -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M12 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M10.5 3H13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M12 11.5C12 11.5 10.7 13 10.7 14C10.7 14.7 11.3 15.2 12 15.2C12.7 15.2 13.3 14.7 13.3 14C13.3 13 12 11.5 12 11.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      <path d="M5 17C5 17 6 15.5 7 15.5C7.8 15.5 8 16.2 8.7 16.2C9.4 16.2 9.7 15.5 10.5 15.5C11.3 15.5 11.5 16.2 12.3 16.2C13 16.2 13.3 15.5 14 15.5C14.8 15.5 15 16.5 16 16.5C17 16.5 17.5 15.3 19 15.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M4.5 17C4.5 19 6 20.5 8.5 20.5H14.5C17.5 20.5 19.5 18.7 19.5 16.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'shield_check' -%}
    {%- # generic — trust / verified shield -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M12 3.5L18.5 6V11.5C18.5 15.8 15.8 18.9 12 20.5C8.2 18.9 5.5 15.8 5.5 11.5V6L12 3.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9 12L11 14L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
