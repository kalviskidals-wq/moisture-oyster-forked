{%- # CUSTOM: net-new snippet — small inline line-art SVG set for MO Trust Bar benefit icons. Used as the fallback when a block has no uploaded icon image, so the icon color token (--mo-trustbar-icon / currentColor) can tint it. The outer ring circle is baked into each SVG (not drawn separately in CSS) so the icon fills its full container, matching the Figma reference. UPSTREAM risk LOW — no Horizon file touched. -%}
{%- # Params: icon (string preset key) -%}
{%- liquid
  assign icon = icon | default: 'none'
-%}
{%- case icon -%}
  {%- when 'dropper_slash' -%}
    {%- # Preservative free — dropper with a slash through it, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M19 7L29 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M16 10L32 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M24 10V21L31 32C33 35.4 30.6 40 26.6 40H21.4C17.4 40 15 35.4 17 32L24 21" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M9 9L39 39" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'test_tube' -%}
    {%- # BAK free — test tube / pipette, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M18 6H30" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M20 7V31C20 34.8 23.2 38 27 38C30.8 38 34 34.8 34 31" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M20 28H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <circle cx="27" cy="33" r="1.5" fill="currentColor"/>
      <path d="M35 7L41 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'water_drops' -%}
    {%- # ~200 drop bottle — two overlapping droplets, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M18 8C18 8 11 17.2 11 23C11 27.2 14.2 30 18 30C21.8 30 25 27.2 25 23C25 17.2 18 8 18 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M31 18C31 18 26 24.8 26 29C26 32.4 28.2 35 31 35C33.8 35 36 32.4 36 29C36 24.8 31 18 31 18Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  {%- when 'hand_drop' -%}
    {%- # GLP tested — dropper releasing a drop above an open palm, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M24 6V18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M21 6H27" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M24 23C24 23 21.4 26 21.4 28C21.4 29.4 22.6 30.4 24 30.4C25.4 30.4 26.6 29.4 26.6 28C26.6 26 24 23 24 23Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M10 34C10 34 12 31 14 31C15.6 31 16 32.4 17.4 32.4C18.8 32.4 19.4 31 21 31C22.6 31 23 32.4 24.6 32.4C26 32.4 26.6 31 28 31C29.6 31 30 33 32 33C34 33 35 30.6 38 31.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M9 34C9 38 12 41 17 41H29C35 41 39 37.4 39 32.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'shield_check' -%}
    {%- # generic — trust / verified shield, ring baked in -%}
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M24 7L37 12V23C37 31.6 31.6 37.8 24 41C16.4 37.8 11 31.6 11 23V12L24 7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M18 24L22 28L31 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
