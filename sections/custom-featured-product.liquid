{%- # CUSTOM: net-new "Hero Product Feature" homepage section (2026-07-18, per Kalvis). Forked from Horizon's native featured-product-information.liquid (not product-information.liquid) since this needs a merchant-editable Product picker — there's no implicit product resource on the homepage/page template the way there is on templates/product.json. UPSTREAM risk MEDIUM — thin fork, re-diff against featured-product-information.liquid after Horizon theme updates. -%}
{%- # CUSTOM (2026-07-18 revision): right side now mirrors the real PDP's "MO Buy Box Card" exactly (eyebrow, title, GLP badge, description, rating link, mo-tier-picker, buy button) with NO custom CTA buttons/modal (that earlier "shortened + 2 buttons" build was scrapped per Kalvis) — everything the PDP shows AFTER the add-to-cart button (accelerated-checkout's dynamic payment buttons + whatever subscription/recurring-payment disclosure Shopify renders alongside them, and mo-pdp-payment-badges) is simply left out of this section's block composition rather than hidden via CSS, since accelerated-checkout is a separate content_for'd block (see blocks/buy-buttons.liquid) that renders nothing at all if it's never declared. No testimonial (per the original shortened-version ask, still true here). -%}
{%- # CUSTOM: load design tokens here (not layout/theme.liquid) since site-wide inclusion is still pending approval — every mo-* block on this page also ships hardcoded var() fallbacks, so it still renders correctly if this tag is ever removed. UPSTREAM risk LOW. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}

{%- # CUSTOM: uses the non-deduplicated inline style tag (not the deduplicated stylesheet tag) for every rule that keys off the section's own id — stylesheet tags are deduplicated per SECTION TYPE, so a section-id-scoped selector inside one only reliably matches a single page instance; style tags render inline per instance instead. Same convention already documented in sections/custom-main-product.liquid and this project's feedback-shopify-theme-validation-gotchas memory. UPSTREAM risk LOW — scoped entirely to this section's own id, no Horizon file touched. -%}
{% style %}
  /* CUSTOM (per Kalvis — homepage section-gap spec): 60px mobile / 80px
     desktop gap to the next section (Eye Health Education), applied
     directly to Shopify's own auto-generated section wrapper since this
     forked-native section has no dedicated top-level mo-* class of its own
     to hang a shared rule on.
     CUSTOM FIX (2026-07-27, per Kalvis): the "Top padding" / "Bottom
     padding" settings below now drive margin-top/margin-bottom here —
     i.e. ONLY the gap before/after this section — instead of the native
     padding-block-start/end (see further below, now fixed at a constant
     40px on every side so the buy-box/media column never shifts when
     these sliders change). margin-top defaults to 0 on both breakpoints
     since Range Grid (the section directly above this one) is currently
     disabled, so Marquee's own margin-bottom already provides the real
     gap above Featured Product. */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.mo_top_padding_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.mo_bottom_padding_mobile | default: 60 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.mo_top_padding_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.mo_bottom_padding_desktop | default: 80 }}px;
    }
  }

  /* CUSTOM FIX (2026-07-27, per Kalvis — reverted 2nd pass): fixed at a
     constant 40px on every side, on purpose — Top/Bottom padding no
     longer touch this (see the margin rule above). Was previously driven
     by mo_top_padding_mobile/desktop via the same containing-block-safe
     override technique as sections/custom-main-product.liquid; kept the
     technique (targeting .section.spacing-style, not a bare
     .spacing-style, so this doesn't leak onto every block's own
     .spacing-style padding) but dropped the schema-var wiring. */
  #shopify-section-{{ section.id }} .section.spacing-style {
    padding-block-start: 40px;
    padding-block-end: 40px;
  }

  /* CUSTOM: replicate the PDP's thumbnail treatment exactly (Kalvis, 2026-07-18) — same rules as sections/custom-main-product.liquid's own inline style block. Force thumbnails to a 1:1 box regardless of each photo's native aspect ratio. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
    aspect-ratio: 1 / 1 !important;
  }

  /* First thumbnail duplicates the main hero image already showing, so it's hidden rather than removed from the loop. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control:first-child {
    display: none;
  }

  /* No border/outline on the active thumbnail, per design. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
    outline: none;
    border: none;
  }

  /* No prev/next arrows over the main image. */
  #shopify-section-{{ section.id }} slideshow-arrows {
    display: none;
  }

  /* CUSTOM FIX (2026-07-20, per Kalvis): hides the subscription/deferred-
     purchase consent disclaimer Shop Pay's accelerated-checkout script
     injects under the payment buttons (<small id="shopify-buyer-consent">,
     inside <shopify-accelerated-checkout> — not theme markup, so it can't be
     removed from Liquid, only hidden with CSS). Same fix as
     sections/custom-main-product.liquid. Note: this section's own header
     comment (top of file) claims accelerated-checkout was left out of this
     "shortened" build's block composition entirely — that's stale; the live
     templates/page.homepage.json DOES nest an "accelerated-checkout" block
     inside this section's mo_buy_buttons, so the disclaimer does render
     here too. Full disclosure is already shown at checkout. */
  #shopify-section-{{ section.id }} #shopify-buyer-consent {
    display: none !important;
  }

  /* CUSTOM FIX (2026-07-22, per Kalvis): "Active and Key Ingredients" / "Uses"
     accordion added directly to this section's block composition on the
     homepage (see templates/index.json's accordion_UiUqw9), but the type
     spec for its heading only ever existed as a scoped override in
     sections/custom-main-product.liquid — a separate section file whose
     styles never load here. Same class of bug as the description fix right
     below, same fix: mirror the PDP's rule exactly. */
  #shopify-section-{{ section.id }} .product-details .details__header {
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 10px;
    line-height: 110%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: #115033;
  }

  /* CUSTOM FIX (2026-07-22, per Kalvis): mo_description block here uses the
     same block id ("mo_description") as the PDP's, but that block's type
     spec (font-family/weight/size/line-height/color, exact Figma values) is
     only defined in sections/custom-main-product.liquid's own inline style
     tag — a separate section file whose styles never load on this page. The
     class matched, the CSS just wasn't present here. Mirrors that rule
     exactly (desktop values; mobile override further down in the existing
     max-width:749px block, same as the PDP's). */
  #shopify-section-{{ section.id }} .text-block--mo_description,
  #shopify-section-{{ section.id }} .text-block--mo_description :is(p, span, div, li, a) {
    font-family: var(--mo-font-heading, 'Manrope', sans-serif) !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 130%;
    letter-spacing: 0;
    color: #0d1b14;
  }

  @media screen and (min-width: 750px) {
    /* CUSTOM: anchor the thumbnail overlay on slideshow-component (not media-gallery itself) —
       media-gallery already carries Horizon's native sticky-content class (position: sticky), and
       setting position: relative directly on it here would override that native rule. */
    #shopify-section-{{ section.id }} .media-gallery--carousel slideshow-component {
      position: relative;
    }

    /* CUSTOM FIX (2026-07-20, per Kalvis — same investigation + fix as
       sections/custom-main-product.liquid, revised after the max-height cap
       alone didn't fully fix it): align-self:stretch matches this column's
       height to product-details' full (viewport-independent) content
       height, while the image slide itself is capped by Horizon's native
       constrain-to-viewport system (--grid-template-rows-desktop: 70dvh
       1fr). The gap between those two balloons as the viewport shrinks,
       pushing the image's rounded bottom corner and the thumbnail rail
       (anchored against this same stretched box) far below the visible
       photo. Per Kalvis: only stretch (and pin the sticky column) when the
       viewport is tall enough for it to make sense — below that, the
       column takes its own natural height and just scrolls normally with
       the rest of the page. */
    @media screen and (min-height: 700px) {
      #shopify-section-{{ section.id }} .product-information__media {
        align-self: stretch;
      }
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      position: absolute;
      left: 30px;
      bottom: 30px;
      top: auto;
      transform: none;
      flex-direction: column;
      width: auto;
      height: auto;
      max-height: calc(100% - 60px);
      z-index: var(--layer-raised, 2);
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      width: auto;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      flex-direction: column;
      margin: 0;
      padding: 0;
      gap: var(--gap-xs, 8px);
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis — same fix as custom-main-
       product.liquid): fixed 80x80 thumbnail size + 10px radius on
       desktop, replacing Horizon's native clamp() sizing and the 12px
       thumbnail_radius schema setting. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
      width: 80px !important;
      height: 80px !important;
      border-radius: 10px !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis): matches the img's own radius to
       the button's — see the mobile-side comment above for why the native
       <img> border-radius needs its own override, not just the button. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control img {
      border-radius: 10px !important;
    }

    /* CUSTOM FIX (2026-07-28, per Kalvis — reverted the 2026-07-28 fluid
       clamp()/cqw rebuild: confirmed the discrete steps below work well,
       so keeping them, same as custom-main-product.liquid): 80px only
       reads correctly on wider desktop screens — on a smaller desktop/
       laptop viewport (or any width squeezed by the cart drawer opening
       — now disabled at every breakpoint, see .page-wrapper--drawer-open
       in custom.css) it crowded the media column. Two extra desktop-only
       breakpoints scale it down further: 60px between 1024–1439px, 40px
       from 750–1023px. Nested @media here combines with this file's
       existing min-width:750px wrapper automatically; both come AFTER
       the 80px rule above in source order, so the later, narrower rule
       wins the cascade at any width they overlap. */
    @media screen and (min-width: 1024px) and (max-width: 1439px) {
      #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
        width: 60px !important;
        height: 60px !important;
      }
    }

    @media screen and (max-width: 1023px) {
      #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
        width: 40px !important;
        height: 40px !important;
      }
    }
  }

  /* CUSTOM: reskin the native add-to-cart button as "Add to Bag +", matching
     the PDP's own buy box exactly (sections/custom-main-product.liquid) — same
     id-prefix technique, since content_for 'block' slots (quantity/add-to-cart/
     accelerated-checkout inside buy-buttons) can't have their block TYPE
     swapped for a custom one (see feedback-shopify-theme-validation-gotchas
     memory), only restyled via CSS targeting the deterministic id prefix. */
  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
    width: 100%;
    background: var(--mo-deep-green, #093d24);
    color: var(--mo-white, #ffffff);
    border: none;
    border-radius: var(--mo-radius-md, 10px);
    padding: 10px 30px;
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-']:hover:not(:disabled) {
    background: var(--mo-green-mid, #115033);
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text__content {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text::after {
    content: 'Add to Bag +';
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
      font-size: 12px;
    }
  }

  /* CUSTOM: hide Seal Subscriptions' own injected widget, same as the PDP —
     we render our own Subscribe/One-time UI via mo-tier-picker and only use
     Seal for the underlying native selling plans. */
  #shopify-section-{{ section.id }} .sealsubs-target-element {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    /* CUSTOM FIX (2026-07-29, per Kalvis — mirrors sections/custom-main-
       product.liquid): accordion body text inside the Buy Box
       (.product-details, same scoping as .details__header above).
       .details-content is Horizon's generic accordion-row content class,
       reused site-wide (footer, cart note, menu drawer), so this stays
       scoped to .product-details to avoid touching those other instances. */
    #shopify-section-{{ section.id }} .product-details .details-content {
      font-size: 12px;
      font-weight: 500;
    }

    /* CUSTOM: replicate the PDP's mobile hero image treatment exactly (Kalvis,
       2026-07-18) — same rules as sections/custom-main-product.liquid's own
       inline style block. Horizon's product-information-content snippet
       hardcodes the media column to grid-column: 1 / -1 on mobile (deliberate
       full-bleed-by-default), which reads as "full width, no padding" — this
       overrides it to match the product-details column's own inset instead,
       so the image sits with the same side padding as the rest of the page. */
    #shopify-section-{{ section.id }} .product-information__media {
      grid-column: 2 / 3;
    }

    /* CUSTOM: hero image crops to a 1:1 square on mobile, matching the PDP.
       Desktop keeps aspect_ratio: adapt (each photo's own natural ratio) —
       untouched, this is mobile-only.
       CUSTOM FIX (2026-07-24, per Kalvis — radius unification pass): radius
       was 10px, mismatched against the 16px testimonial/buy-box cards
       stacked below it on mobile. Raised to 16px to match (same fix as
       custom-main-product.liquid). */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container {
      aspect-ratio: 1 / 1 !important;
      border-radius: 16px !important;
    }

    #shopify-section-{{ section.id }} .product-information__media .product-media-container :is(img, video, .deferred-media__poster-image) {
      object-fit: cover !important;
      border-radius: 16px !important;
    }

    /* CUSTOM FIX (2026-07-29, per Kalvis — mirrors sections/custom-main-
       product.liquid, see that file's own comment for the full root-cause
       writeup): the previous "flex-basis" fix here was wrong (didn't
       clear the reported gap/non-square image on real iPhone Safari) and
       has been removed. Actual cause: .product-media-container's
       aspect-ratio:1/1 above only forces the OUTER box square — the
       .product-media wrapper one level inside it (snippets/product-
       media.liquid) has its OWN separate aspect-ratio (the photo's
       natural ratio, via --ratio), and since .product-media is also
       flex:1 inside the outer box's flex row, which of the two competing
       aspect-ratios wins is a flexbox+aspect-ratio edge case Blink and
       WebKit apparently resolve differently. Forcing this inner wrapper
       to 1/1 too removes the conflict entirely. */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container .product-media {
      aspect-ratio: 1 / 1 !important;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      padding-block-start: 0;
      justify-content: flex-start !important;
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      padding-block: 10px;
      /* CUSTOM FIX (2026-07-27, per Kalvis — same fix as custom-main-
         product.liquid): Horizon ships a small built-in inline padding
         here (~11.2px) that margin-inline:0 doesn't touch (margin and
         padding are independent) — left the first thumbnail's left edge
         sitting right of the main image/other elements' shared left edge.
         Zeroing inline padding puts the row flush with that same edge. */
      padding-inline-start: 0 !important;
      margin-block-start: 0 !important;
      margin-inline: 0 !important;
      justify-content: flex-start !important;
      align-self: flex-start !important;
      width: fit-content !important;
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      justify-content: flex-start !important;
      align-items: flex-start !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis — same fix as custom-main-
       product.liquid): fixed 32x32 thumbnail size + 4px radius on mobile,
       replacing Horizon's native clamp(44px, 7vw, ...) sizing and the
       12px thumbnail_radius schema setting (templates/index.json's
       featured-product block). */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
      width: 32px !important;
      height: 32px !important;
      border-radius: 4px !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis — "almost a circle" root cause):
       Horizon's native CSS also sets border-radius directly on the <img>
       itself (snippets/slideshow-controls.liquid), independent of the
       button's own clip box — at a 32px box the native 12px radius reads
       as ~37%, nearly a full circle, regardless of the button's radius
       above. Matches the img's radius to 4px explicitly. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control img {
      border-radius: 4px !important;
    }

    /* CUSTOM: product description mobile type spec (Kalvis) — same as the
       PDP's mobile override, font-family/weight/color inherited from the
       desktop rule above, only size/line-height/letter-spacing differ. */
    #shopify-section-{{ section.id }} .text-block--mo_description,
    #shopify-section-{{ section.id }} .text-block--mo_description :is(p, span, div, li, a) {
      font-size: 12px;
      line-height: 130%;
      letter-spacing: -0.02em;
    }
  }
{% endstyle %}

{%- liquid
  assign featured_product = section.settings.product
-%}

<script type="application/ld+json">
  {{ featured_product | structured_data }}
</script>

{%- # CUSTOM: passing closest.product explicitly, matching the confirmed-working pattern already used in sections/custom-main-product.liquid (closest.product: closest.product) and documented in snippets/product-information-content.liquid's @example. -%}
{% capture media_gallery %}
  {% content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<featured-product-information id="{{ section.id }}">
  <h2 class="visually-hidden">{{ featured_product.title | escape }}</h2>
  {% render 'product-information-content',
    product: featured_product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
</featured-product-information>

{% schema %}
{
  "name": "MO Featured Product",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#093D24"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "info": "Not used — see Top padding (mobile / desktop) below instead."
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "info": "Not used — see Bottom padding (mobile / desktop) below instead."
    },
    {
      "type": "header",
      "content": "Top padding"
    },
    {
      "type": "range",
      "id": "mo_top_padding_mobile",
      "label": "Space above section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the media/buy-box position inside this section."
    },
    {
      "type": "range",
      "id": "mo_top_padding_desktop",
      "label": "Space above section — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the media/buy-box position inside this section."
    },
    {
      "type": "header",
      "content": "Bottom padding"
    },
    {
      "type": "range",
      "id": "mo_bottom_padding_mobile",
      "label": "Space after section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60,
      "info": "Gap to the next section only — doesn't affect the media/buy-box position inside this section."
    },
    {
      "type": "range",
      "id": "mo_bottom_padding_desktop",
      "label": "Space after section — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80,
      "info": "Gap to the next section only — doesn't affect the media/buy-box position inside this section."
    }
  ],
  "presets": [
    {
      "name": "MO Featured Product",
      "category": "Custom",
      "settings": {
        "gap": 40,
        "equal_columns": true,
        "background_color": "#093D24",
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 4,
            "large_first_image": false,
            "icons_style": "chevron",
            "slideshow_controls_style": "thumbnails",
