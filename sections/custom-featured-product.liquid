{%- # CUSTOM: net-new "Hero Product Feature" homepage section — reuses the exact same product-details block tree as the PDP's custom-main-product.liquid (mo-pdp-eyebrow, mo-pdp-badge, mo-pdp-rating-link, mo-tier-picker, the reskinned buy-buttons, mo-pdp-payment-badges), but forked from Horizon's native featured-product-information.liquid pattern instead of product-information.liquid, since this section needs a merchant-editable Product picker (there's no implicit product resource on the homepage/page template the way there is on templates/product.json). UPSTREAM risk MEDIUM — thin fork, re-diff against featured-product-information.liquid after Horizon theme updates. -%}
{%- # CUSTOM: load design tokens here (not layout/theme.liquid) since site-wide inclusion is still pending approval — every mo-* block on this page also ships hardcoded var() fallbacks, so it still renders correctly if this tag is ever removed. UPSTREAM risk LOW. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = section.settings.product
-%}

<script type="application/ld+json">
  {{ featured_product | structured_data }}
</script>

{%- # CUSTOM: passing closest.product explicitly (not relying only on the implicit auto-resolution Shopify does for a section's own "product"-type setting) — this is the same explicit-pass pattern already confirmed working on the PDP (sections/custom-main-product.liquid uses closest.product: closest.product the same way), and matches the documented @example in snippets/product-information-content.liquid. -%}
{% capture media_gallery %}
  {% content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<featured-product-information id="{{ section.id }}">
  <h2 class="visually-hidden">{{ featured_product.title | escape }}</h2>
  {% render 'product-information-content',
    product: featured_product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
</featured-product-information>

{% stylesheet %}
  /* CUSTOM: reskin the native add-to-cart button as "Add to Bag +", matching
     the PDP's own buy box exactly (sections/custom-main-product.liquid) — same
     id-prefix technique, since content_for 'block' slots (quantity/add-to-cart/
     accelerated-checkout inside buy-buttons) can't have their block TYPE
     swapped for a custom one (see feedback-shopify-theme-validation-gotchas
     memory), only restyled via CSS targeting the deterministic id prefix.
     Per Kalvis (2026-07-18). UPSTREAM risk LOW — scoped to this section only. */
  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
    width: 100%;
    background: var(--mo-deep-green, #093d24);
    color: var(--mo-white, #ffffff);
    border: none;
    border-radius: var(--mo-radius-md, 10px);
    padding: 10px 30px;
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-']:hover:not(:disabled) {
    background: var(--mo-green-mid, #115033);
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text__content {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text::after {
    content: 'Add to Bag +';
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
      font-size: 12px;
    }
  }

  /* CUSTOM: hide Seal Subscriptions' own injected widget, same as the PDP —
     we render our own Subscribe/One-time UI via mo-tier-picker and only use
     Seal for the underlying native selling plans. */
  #shopify-section-{{ section.id }} .sealsubs-target-element {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MO Featured Product",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "MO Featured Product",
      "category": "Custom",
      "settings": {
        "gap": 40,
        "equal_columns": true,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 4,
            "large_first_image": false,
            "icons_style": "chevron",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "thumbnails",
            "thumbnail_position": "bottom",
            "thumbnail_width": 56,
            "thumbnail_radius": 12,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 24,
            "extend_media": false,
            "zoom": false,
            "video_loop": false,
            "hide_variants": true
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
