{%- # CUSTOM: net-new "Hero Product Feature" homepage section — a SHORTENED teaser version of the PDP buy box (image + title + price + 2 CTAs only, no testimonial/badge/description/rating/payment-badges), per Kalvis (2026-07-18): "shortened version, but with a possibility to add to cart all options... no testimonial all other not essential elements stripped, 2 buttons: 1. purchase options - opens buying options 2. view full info - opens the product page." Forked from Horizon's native featured-product-information.liquid (not product-information.liquid) since this needs a merchant-editable Product picker — there's no implicit product resource on the homepage/page template the way there is on templates/product.json. UPSTREAM risk MEDIUM — thin fork, re-diff against featured-product-information.liquid after Horizon theme updates. -%}
{%- # CUSTOM: load design tokens here (not layout/theme.liquid) since site-wide inclusion is still pending approval — every mo-* block on this page also ships hardcoded var() fallbacks, so it still renders correctly if this tag is ever removed. UPSTREAM risk LOW. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = section.settings.product
-%}

<script type="application/ld+json">
  {{ featured_product | structured_data }}
</script>

{%- # CUSTOM: two SEPARATE _product-details block instances (same native block type, different ids) — the same "duplicate a block type under two ids" technique already used on the PDP for its mobile-testimonial instance (see [[moisture-oyster-project]]). "product-details" is the slim, always-visible card (title + price only); "product-details-full" holds the REAL mo-tier-picker + buy-buttons (full quantity/subscribe options + working add-to-cart), rendered normally at page load but visually hidden inside a <dialog> until "Purchase Options" is clicked — deliberately NOT using Horizon's shared native quick-add-dialog/AJAX pipeline (snippets/quick-add-modal.liquid), since that's built around fetching a product-card's own quick-add section over AJAX and re-mounting its contents; our mo-variant-main-picker's mount script isn't written to handle being injected after the fact, so server-rendering the full picker inline (just hidden) and only toggling the dialog's [open] state is the safer, more predictable choice. Passing closest.product explicitly to both, matching the confirmed-working pattern already used in sections/custom-main-product.liquid. -%}
{% capture media_gallery %}
  {% content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture cta_row %}
  <div class="mo-featured-product__ctas">
    <button
      type="button"
      class="mo-btn mo-btn--bag mo-featured-product__cta"
      data-mo-fp-open
    >
      Purchase Options
    </button>
    <a
      href="{{ featured_product.url }}"
      class="mo-btn mo-btn--outline mo-featured-product__cta"
    >
      View Full Info
    </a>
  </div>
{% endcapture %}

{%- # CUSTOM: appends the CTA row's markup directly onto the slim product-details capture (both are just strings at this point) so the buttons render inside the SAME details column, right under title + price — no extra grid wiring needed. -%}
{% assign product_details = product_details | append: cta_row %}

{% capture product_details_full %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details-full',
    closest.product: featured_product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<featured-product-information id="{{ section.id }}">
  <h2 class="visually-hidden">{{ featured_product.title | escape }}</h2>
  {% render 'product-information-content',
    product: featured_product,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks
  %}
</featured-product-information>

<dialog
  id="MoFeaturedProductDialog-{{ section.id }}"
  class="dialog-modal color-custom-popover mo-featured-product__dialog"
>
  <button
    type="button"
    class="button button-unstyled close-button mo-featured-product__dialog-close"
    aria-label="{{ 'accessibility.close_dialog' | t }}"
    data-mo-fp-close
  >
    {{- 'icon-close.svg' | inline_asset_content -}}
  </button>
  <div class="mo-featured-product__dialog-content">
    {{ product_details_full }}
  </div>
</dialog>

{%- # CUSTOM: plain scoped vanilla JS (no shared component), matching the small inline-script pattern already used for the sticky-add-to-cart scroll-to-buybox behavior in sections/custom-main-product.liquid. Deliberately simple: no focus-trap/animation-out choreography beyond what .dialog-modal's own CSS already provides via the native [open] attribute. UPSTREAM risk LOW — scoped entirely to this section's own ids. -%}
<script>
  (function () {
    var dialog = document.getElementById('MoFeaturedProductDialog-{{ section.id }}');
    var openBtn = document.querySelector('#shopify-section-{{ section.id }} [data-mo-fp-open]');
    if (!dialog || !openBtn || openBtn.dataset.mounted === 'true') return;
    openBtn.dataset.mounted = 'true';

    var closeBtn = dialog.querySelector('[data-mo-fp-close]');

    openBtn.addEventListener('click', function () {
      dialog.showModal();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        dialog.close();
      });
    }

    dialog.addEventListener('click', function (event) {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>

{% stylesheet %}
  /* CUSTOM: reskin the native add-to-cart button as "Add to Bag +", matching
     the PDP's own buy box exactly (sections/custom-main-product.liquid) — same
     id-prefix technique, since content_for 'block' slots (quantity/add-to-cart/
     accelerated-checkout inside buy-buttons) can't have their block TYPE
     swapped for a custom one (see feedback-shopify-theme-validation-gotchas
     memory), only restyled via CSS targeting the deterministic id prefix.
     Applies inside the dialog too, since it's the same section id. Per Kalvis
     (2026-07-18). UPSTREAM risk LOW — scoped to this section only. */
  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
    width: 100%;
    background: var(--mo-deep-green, #093d24);
    color: var(--mo-white, #ffffff);
    border: none;
    border-radius: var(--mo-radius-md, 10px);
    padding: 10px 30px;
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-']:hover:not(:disabled) {
    background: var(--mo-green-mid, #115033);
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text__content {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text::after {
    content: 'Add to Bag +';
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
      font-size: 12px;
    }
  }

  /* CUSTOM: hide Seal Subscriptions' own injected widget, same as the PDP —
     we render our own Subscribe/One-time UI via mo-tier-picker and only use
     Seal for the underlying native selling plans. */
  #shopify-section-{{ section.id }} .sealsubs-target-element {
    display: none !important;
  }

  /* CUSTOM: the two-button CTA row appended to the slim product-details card. */
  .mo-featured-product__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--mo-space-4, 16px);
    margin-top: var(--mo-space-5, 20px);
  }

  .mo-featured-product__cta {
    flex: 1 1 auto;
    min-width: 200px;
  }

  /* CUSTOM: dialog content just needs some breathing room inside the shared
     .dialog-modal chrome (border/shadow/backdrop/open-close animation all
     come from that class already, see assets/base.css). */
  .mo-featured-product__dialog {
    padding: var(--mo-space-8, 40px);
    max-width: 480px;
    width: calc(100% - var(--mo-space-8, 40px));
  }

  .mo-featured-product__dialog-content .product-details {
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MO Featured Product",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "MO Featured Product",
      "category": "Custom",
      "settings": {
        "gap": 40,
        "equal_columns": true,
        "padding-block-start": 40,
        "padding-block-end": 40
      },
      "blocks": {
        "media-gallery": {
          "type": "_product-media-gallery",
          "static": true,
          "settings": {
            "media_presentation": "carousel",
            "media_columns": "one",
            "image_gap": 4,
            "large_first_image": false,
            "icons_style": "chevron",
            "slideshow_controls_style": "thumbnails",
            "slideshow_mobile_controls_style": "thumbnails",
            "thumbnail_position": "bottom",
            "thumbnail_width": 56,
            "thumbnail_radius": 12,
            "aspect_ratio": "adapt",
            "constrain_to_viewport": true,
            "media_fit": "contain",
            "media_radius": 24,
            "extend_media": false,
            "zoom": false,
            "video_loop": false,
            "hide_variants": true
          }
        },
        "product-details": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 12,
            "sticky_details_desktop": true,
            "background_media": "none",
            "border": "none"
          },
          "blocks": {
            "mo_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h2",
                "font": "var(--font-body--family)",
                "font_size": "1.5rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "#093d24"
              }
            },
            "mo_price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_installments": false,
                "show_tax_info": false,
                "alignment": "left"
              }
            }
          },
          "block_order": ["mo_title", "mo_price"]
        },
        "product-details-full": {
          "type": "_product-details",
          "static": true,
          "settings": {
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "details_position": "flex-start",
            "gap": 20,
            "sticky_details_desktop": false,
            "background_media": "none",
            "border": "none"
          },
          "blocks": {
            "mo_tier_picker": {
              "type": "mo-tier-picker",
              "name": "MO Tier + Sub Picker",
              "settings": {
                "quantity_label": "Quantity",
                "purchase_label": "Purchase Option",
                "subscribe_title": "Subscribe",
                "onetime_title": "One-Time",
                "deliver_prefix": "Deliver every",
                "card_bg_inactive": "#ffffff",
                "card_border_inactive": "#1fa567",
                "card_bg_active": "#1fa567",
                "card_border_active": "#1fa567",
                "card_text_active": "#ffffff",
                "card_text_inactive": "#093d24",
                "badge_save_bg": "#ffffff",
                "badge_save_text": "#115033",
                "badge_value_bg": "#ffffff",
                "badge_value_text": "#115033",
                "badge_value_border": "#c4c1ba",
                "bubble_bg": "#ffd5f7",
                "bubble_text": "#093d24"
              }
            },
            "mo_buy_buttons": {
              "type": "buy-buttons",
              "name": "t:names.product_buy_buttons",
              "settings": {
                "stacking": true
              },
              "blocks": {
                "quantity": {
                  "type": "quantity",
                  "static": true
                },
                "add-to-cart": {
                  "type": "add-to-cart",
                  "static": true,
                  "settings": {
                    "style_class": "button"
                  }
                },
                "accelerated-checkout": {
                  "type": "accelerated-checkout",
                  "static": true
                }
              },
              "block_order": []
            }
          },
          "block_order": ["mo_tier_picker", "mo_buy_buttons"]
        }
      }
    }
  ]
}
{% endschema %}
