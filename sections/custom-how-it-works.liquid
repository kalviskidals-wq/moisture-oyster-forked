{%- # CUSTOM: net-new theme section — Homepage "How It Works" subscription explainer. Left column (a .mo-hiw__left wrapper holding the heading + a body panel showing the active step's copy, stacked with a fixed flex gap) sits beside a right column of repeatable step blocks that act as tabs (number pill + large heading). Desktop: .mo-hiw__left becomes a real flex column and .mo-hiw__tablist a separate grid cell beside it. Mobile: .mo-hiw__left switches to display:contents so header/body promote back out to their own individually-assigned grid areas, reflowing into source order (header, body, tablist) via a mobile grid-template-areas override — no absolute-position overlay trick needed since there is no full-bleed photo background here. Tabs + panels reuse assets/mo-tabs.js (already built for custom-ingredient-transparency.liquid) for click + arrow-key/Home/End roving-tabindex nav. Unlike that section's progressive-enhancement convention (all panels visible, JS-only hiding), this section's a11y spec calls for the non-active panels to ship server-hidden via the `hidden` attribute directly (first step server-rendered active), since mo-tabs.js's own connectedCallback re-applies the same hidden state on load regardless, so behavior is identical either way. CUSTOM (2026-07-19, per Kalvis): the lifestyle image this section originally also carried (below the body panel) was removed entirely, both breakpoints — no image setting/markup remains. UPSTREAM risk LOW — no Horizon file touched. -%}
{%- # CUSTOM: load design tokens + the .mo-hiw rules here (not layout/theme.liquid) since site-wide inclusion is still pending approval. Every mo-* element also ships hardcoded var() fallbacks so this still renders correctly if either tag is ever removed. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}
{{ 'custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mo-tabs.js' | asset_url }}" type="module"></script>

{%- liquid
  assign s = section.settings
-%}

<section
  class="mo-hiw"
  id="MoHowItWorks-{{ section.id }}"
  style="
    --mo-hiw-bg: {{ s.background_color | default: '#093D24' }};
    --mo-hiw-heading: {{ s.heading_color | default: '#FFFFFF' }};
    --mo-hiw-body: {{ s.body_color | default: '#FFFFFF' }};
    --mo-hiw-tab-heading: {{ s.tab_heading_color | default: '#FFFFFF' }};
    --mo-hiw-tab-heading-active: {{ s.tab_heading_active_color | default: '#B8F3D8' }};
    --mo-hiw-number-bg: {{ s.number_pill_color | default: '#FFD5F7' }};
    --mo-hiw-number-text: {{ s.number_pill_text_color | default: '#093D24' }};
    --mo-hiw-divider: {{ s.divider_color | default: '#B8F3D8' }};
    --mo-hiw-margin-bottom-desktop: {{ s.vertical_padding | default: 80 }}px;
    --mo-hiw-margin-top-mobile: {{ s.top_padding_mobile | default: 0 }}px;
    --mo-hiw-margin-top-desktop: {{ s.top_padding_desktop | default: 0 }}px;
    --mo-hiw-margin-bottom-mobile: {{ s.bottom_padding_mobile | default: 60 }}px;
  "
>
  <div class="mo-hiw__inner">
    {%- # CUSTOM: data-hover-activate opts this instance into mo-tabs.js's hover-to-activate behavior (desktop only, gated by a pointer/hover media query in that file) per Kalvis (2026-07-17) — tap still activates on touch.
       CUSTOM FIX (2026-07-27, per Kalvis): data-scroll-into-view-on-activate opts this instance into mo-tabs.js's "scroll the changed content back into view" fix — on mobile, the tablist sits BELOW the header/body panel it controls, so a shopper who has scrolled down to the tablist (out of view of the header/body above) can tap a tab and see nothing change, since the body text that just updated is off-screen above them. mo-tabs.js scrolls the [data-scroll-anchor] element below back into view (mobile only, and only when it's actually out of view) after a real tap/keyboard activation. Not set on custom-ingredient-transparency.liquid's <mo-tabs> — that layout has tabs above the panel they control, so this bug doesn't apply there. -%}
    <mo-tabs class="mo-hiw__tabs" data-hover-activate data-scroll-into-view-on-activate>
      <div class="mo-hiw__grid">
        {%- # CUSTOM (2026-07-14 fix): header/body/image now share one .mo-hiw__left wrapper. On desktop it's a real flex column (so the body-to-image gap is a single fixed flex `gap`, never influenced by the tablist's own height/spanning) and on mobile it's `display:contents` (dissolves so header/body/image still promote to their own individually-assigned grid-area, keeping the required header→body→tablist→image stacking order). Replaces the earlier "tablist spans 3 grid rows" technique, which left the left column's exact vertical rhythm dependent on grid row-track distribution math instead of a plain, predictable gap. -%}
        <div class="mo-hiw__left">
          <div class="mo-hiw__header" data-scroll-anchor>
            {%- if s.heading != blank -%}
              <h2 class="mo-hiw__heading">{{ s.heading | escape }}</h2>
            {%- endif -%}
          </div>

          <div class="mo-hiw__body">
            {%- for block in section.blocks -%}
              {%- if block.type == 'step' -%}
                {%- liquid
                  assign panel_id = 'MoHiwPanel-' | append: section.id | append: '-' | append: block.id
                  assign tab_id = 'MoHiwTab-' | append: section.id | append: '-' | append: block.id
                -%}
                <div
                  class="mo-hiw__panel mo-body-lg"
                  id="{{ panel_id }}"
                  role="tabpanel"
                  aria-labelledby="{{ tab_id }}"
                  tabindex="0"
                  {% unless forloop.first %}hidden{% endunless %}
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.body | newline_to_br }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

        </div>

        <div class="mo-hiw__tablist" role="tablist" aria-label="{{ s.heading | strip_newlines | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- liquid
                assign bs = block.settings
                assign panel_id = 'MoHiwPanel-' | append: section.id | append: '-' | append: block.id
                assign tab_id = 'MoHiwTab-' | append: section.id | append: '-' | append: block.id
                assign is_first = false
                if forloop.first
                  assign is_first = true
                endif
              -%}
              <button
                type="button"
                class="mo-hiw__tab{% if is_first %} is-active{% endif %}"
                id="{{ tab_id }}"
                role="tab"
                aria-selected="{{ is_first }}"
                aria-controls="{{ panel_id }}"
                tabindex="{% if is_first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if bs.number != blank -%}
                  <span class="mo-hiw__tab-number" aria-hidden="true">{{ bs.number | escape }}</span>
                {%- endif -%}
                {%- if bs.heading != blank -%}
                  <span class="mo-hiw__tab-heading">{{ bs.heading | escape }}</span>
                {%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </mo-tabs>
  </div>
</section>

{% schema %}
{
  "name": "MO How It Works",
  "tag": "section",
  "class": "mo-hiw-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#093D24"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tab_heading_color",
      "label": "Step heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tab_heading_active_color",
      "label": "Active step heading color",
      "default": "#B8F3D8"
    },
    {
      "type": "color",
      "id": "number_pill_color",
      "label": "Number pill background",
      "default": "#FFD5F7"
    },
    {
      "type": "color",
      "id": "number_pill_text_color",
      "label": "Number pill text color",
      "default": "#093D24"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#B8F3D8"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "bottom_padding_mobile",
      "label": "Space after section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60,
      "info": "Gap to the next section only — doesn't affect the heading/step-list spacing inside this section."
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Space after section — desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80,
      "info": "Gap to the next section only — doesn't affect the heading/step-list spacing inside this section."
    },
    {
      "type": "range",
      "id": "top_padding_mobile",
      "label": "Space above section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the heading/step-list spacing inside this section."
    },
    {
      "type": "range",
      "id": "top_padding_desktop",
      "label": "Space above section — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the heading/step-list spacing inside this section."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Step heading",
          "info": "Also acts as the tab button label."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Add body copy here",
          "info": "Shown in the shared body panel on the left when this step is active."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MO How It Works",
      "category": "Custom",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "1",
            "heading": "Choose your frequency",
            "body": "Select 30, 60, or 90-day delivery cycles. Adjust anytime from your account dashboard — no friction, no lock-in."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "heading": "Free delivery, every time",
            "body": "All subscriptions ship free across the US. Your drops arrive before you run out — every time, guaranteed."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "3",
            "heading": "Pause or cancel freely",
            "body": "No lock-ins. Pause, skip, or cancel your subscription in one tap — no questions asked."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["index", "page"]
  }
}
{% endschema %}
