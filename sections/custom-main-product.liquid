{%- # CUSTOM: forked from Horizon sections/product-information.liquid (untouched). UPSTREAM risk MEDIUM — we own maintenance of this fork; re-diff against product-information.liquid after Horizon theme updates. -%}
{%- # CUSTOM: body below is intentionally near-identical to the stock section — this file only changes which block types the PDP composes (see templates/product.json), not the section's own rendering logic. Keeping the fork thin minimizes merge pain. -%}
{%- # CUSTOM: load design tokens here (not layout/theme.liquid) since site-wide inclusion is still pending approval — see mo-design-system.css header notes. Every mo-* block on this page also ships hardcoded var() fallbacks, so the page still renders correctly even if this tag is ever removed. UPSTREAM risk LOW. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}

{%- # CUSTOM: hero gallery thumbnail overlay per hero-image design spec. Horizon's native thumbnails-style controls hardcode controls_on_media to false (see snippets/product-media-gallery-content.liquid), so an on-image floating rail isn't reachable via block settings alone — this scoped override achieves it with CSS instead. Uses the non-deduplicated inline style tag (not the deduplicated stylesheet tag) specifically because the deduplicated one is shared theme-wide and can't be scoped with the section id — see feedback-shopify-theme-validation-gotchas memory. UPSTREAM risk LOW — scoped entirely to this section's shopify-section wrapper id, no Horizon file touched. -%}
{% style %}
  /* CUSTOM (per Kalvis — PDP section-gap spec): 60px mobile / 80px desktop
     gap to the next section (Trust Bar), applied directly to Shopify's own
     auto-generated section wrapper since this forked-native section has no
     dedicated top-level mo-* class of its own to hang a shared rule on
     (same technique as sections/custom-featured-product.liquid's homepage
     equivalent).
     CUSTOM FIX (2026-07-27, per Kalvis): the "Top padding" / "Bottom
     padding" settings below now drive margin-top/margin-bottom here — i.e.
     ONLY the gap before/after this section — instead of the native
     padding-block-start/end (see further below, now fixed at a constant
     32px start / 10px end on every breakpoint so the gallery/buy-box
     column never shifts when these sliders change, matching the same
     approach as sections/custom-featured-product.liquid). margin-top
     defaults to 0 since this is the first section on the page (nothing
     precedes it). */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.mo_top_padding_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.mo_bottom_padding_mobile | default: 60 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.mo_top_padding_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.mo_bottom_padding_desktop | default: 80 }}px;
    }
  }

  /* CUSTOM FIX (2026-07-27, per Kalvis — reverted 2nd pass): fixed at a
     constant 32px start / 10px end on every breakpoint, on purpose — Top/
     Bottom padding no longer touch this (see the margin rule above). Was
     previously driven by mo_top_padding_mobile/desktop and
     mo_bottom_padding_mobile/desktop via the same containing-block-safe
     override technique; kept the technique (targeting .section.spacing-style,
     not a bare .spacing-style, so this doesn't leak onto every block's own
     .spacing-style padding) but dropped the schema-var wiring. */
  #shopify-section-{{ section.id }} .section.spacing-style {
    padding-block-start: 32px;
    padding-block-end: 10px;
  }

  /* Force thumbnails to a 1:1 box regardless of each photo's native aspect ratio. Main slides keep aspect_ratio: adapt (their own natural ratio) untouched — that setting lives in templates/product.json media-gallery block settings. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
    aspect-ratio: 1 / 1 !important;
  }

  /* First thumbnail duplicates the main hero image already showing, so it's hidden rather than removed from the loop (that loop lives in the native slideshow-controls snippet, which we don't touch). */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control:first-child {
    display: none;
  }

  /* No border/outline on the active thumbnail, per design. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
    outline: none;
    border: none;
  }

  /* CUSTOM FIX (2026-07-20, per Kalvis): hides the subscription/deferred-
     purchase consent disclaimer Shop Pay's own accelerated-checkout script
     injects under the payment buttons (<small id="shopify-buyer-consent">,
     inside <shopify-accelerated-checkout> — not theme markup, so it can't be
     removed from Liquid, only hidden with CSS). Same disclosure is already
     shown in full at checkout, so this was a redundant repeat on the
     product page itself. #shopify-buyer-consent is Shopify's own stable id
     for this element (not one of ours), scoped to this section only since
     that's the sole place it renders on the PDP. */
  #shopify-section-{{ section.id }} #shopify-buyer-consent {
    display: none !important;
  }

  /* CUSTOM FIX (2026-07-20, per Kalvis — reported on a MacBook Air 13.6"
     screen, but affects desktop generally): Horizon's own media_radius
     (24px)/thumbnail_radius (12px) settings from templates/product.json's
     media-gallery block aren't rendering — the main image and thumbnails
     both show sharp corners at desktop widths. Rather than chase why
     Horizon's own --media-radius-driven CSS (snippets/product-media.liquid,
     slideshow-controls.liquid) isn't taking effect, reapplied directly
     here on the same selector already confirmed working for the
     mobile-only radius fix further down this file. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
    border-radius: 12px !important;
    overflow: hidden;
  }

  /* No prev/next arrows over the main image. */
  #shopify-section-{{ section.id }} slideshow-arrows {
    display: none;
  }

  /* CUSTOM: product description body text type spec (Kalvis, exact Figma values). Targets the
     description block's stable per-instance class (text-block--mo_description, from its JSON block
     id) rather than a generic selector, since product-description's own schema only exposes preset
     keywords (tight/normal/loose) for line-height/letter-spacing, not exact percentage values.
     Desktop values here are the default; the max-width:749px block below overrides size/line-height/
     letter-spacing for mobile per its own separate spec. */
  #shopify-section-{{ section.id }} .text-block--mo_description,
  #shopify-section-{{ section.id }} .text-block--mo_description :is(p, span, div, li, a) {
    font-family: var(--mo-font-heading, 'Manrope', sans-serif) !important;
    font-weight: 500;
    font-size: 14px;
    line-height: 130%;
    letter-spacing: 0;
    color: #0d1b14;
  }

  /* CUSTOM: Active Ingredient / Uses accordion heading type spec (Kalvis, exact Figma values).
     Horizon's native accordion block only exposes a type_preset dropdown (h1-h6/paragraph), not
     arbitrary font values, so this is a scoped override on the summary element instead. */
  #shopify-section-{{ section.id }} .product-details .details__header {
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 10px;
    line-height: 110%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: #115033;
  }

  /* CUSTOM: sticky add-to-cart bar shows only a Subscribe first-order-discount
     callout, no dollar price — see the sticky-add-to-cart markup for the Liquid.
     max-width keeps the phrase from crowding out the image/title/button in the
     bar's compact row; it can wrap to two lines if needed. */
  #shopify-section-{{ section.id }} .sticky-add-to-cart__price {
    max-width: 9rem;
    text-align: right;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .sticky-add-to-cart__price-label {
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @media screen and (min-width: 750px) {
    /* CUSTOM: anchor the thumbnail overlay on slideshow-component (not media-gallery itself) —
       media-gallery already carries Horizon's native sticky-content class (position: sticky) for the
       sticky-left-column behavior below, and setting position: relative directly on it here would
       override that native rule (same element, higher specificity wins) and silently break stickiness. */
    #shopify-section-{{ section.id }} .media-gallery--carousel slideshow-component {
      position: relative;
    }

    /* CUSTOM: left media column stays pinned while the taller right column (testimonial + buy box)
       scrolls past. sticky-content is already present on <media-gallery> natively and needs its
       grid cell to stay the FULL row height (matching the taller product-details column) to have
       room to stick within — align-self: stretch guarantees that even if something else in this
       section's cascade nudges the default grid alignment. UPSTREAM risk LOW, scoped to this section only.
       CUSTOM FIX (2026-07-20, per Kalvis — devtools investigation, revised after the max-height cap
       alone didn't fully fix it): stretching this column to match product-details' full height (often
       1000px+) fights Horizon's own native media sizing — the image slide itself is capped to 70dvh
       via Horizon's constrain-to-viewport system (--grid-template-rows-desktop: 70dvh 1fr, confirmed
       in devtools), and its remaining "1fr" row fills whatever LEFTOVER height align-self:stretch
       hands it. On a short viewport that leftover gap balloons, pushing the image's rounded bottom
       corner and the thumbnail rail (anchored against this same stretched box, see below) far below
       the visible photo. Per Kalvis: rather than try to bound that gap, only stretch (and therefore
       only pin the sticky column for the long scroll) when the viewport is actually tall enough for it
       to make sense — below that, the column takes its own natural (image-sized) height instead, so it
       simply scrolls normally with the rest of the page like any other content once you scroll past it. */
    @media screen and (min-height: 700px) {
      #shopify-section-{{ section.id }} .product-information__media {
        align-self: stretch;
      }
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      position: absolute;
      left: 30px;
      bottom: 30px;
      top: auto;
      transform: none;
      flex-direction: column;
      width: auto;
      height: auto;
      max-height: calc(100% - 60px);
      z-index: var(--layer-raised, 2);
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      width: auto;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      flex-direction: column;
      margin: 0;
      padding: 0;
      gap: var(--gap-xs, 8px);
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis): fixed 80x80 thumbnail size + 10px
       radius on desktop — was Horizon's native clamp(44px, 7vw, ...) sizing
       and the shared global 12px radius (see the un-scoped rule near the
       top of this file, which still governs any breakpoint this doesn't
       explicitly override). !important beats the native clamp() rule at
       equal specificity since this comes later in the cascade. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
      width: 80px !important;
      height: 80px !important;
      border-radius: 10px !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis): matches the img's own radius to
       the button's — see the identical mobile-side comment above for why
       the native <img> border-radius (set separately in snippets/
       slideshow-controls.liquid) needs its own override, not just the
       button/clip box. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control img {
      border-radius: 10px !important;
    }

    /* CUSTOM FIX (2026-07-28, per Kalvis): 80px only reads correctly on
       wider desktop screens — on a smaller desktop/laptop viewport (or
       any width squeezed by the cart drawer opening, since that reduces
       the same available column width) it crowded the media column.
       Two extra desktop-only breakpoints scale it down further: 60px
       between 1024–1439px, 40px from 750–1023px. Nested @media here
       (rather than separate top-level blocks) combines with this file's
       existing min-width:750px wrapper automatically — standard CSS,
       not the newer nesting syntax. Both come AFTER the 80px rule above
       in source order, so at any width they match (e.g. 900px matches
       both the unconditional 80px rule and the 750–1023px range below),
       the later, narrower rule wins the cascade — exact breakpoints are
       a reasonable starting point, not measured against a specific
       Figma frame; adjust if a size looks off on a real device. */
    @media screen and (min-width: 1024px) and (max-width: 1439px) {
      #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
        width: 60px !important;
        height: 60px !important;
      }
    }

    @media screen and (max-width: 1023px) {
      #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
        width: 40px !important;
        height: 40px !important;
      }
    }

    /* CUSTOM FIX (2026-07-20, per Kalvis — reported on a MacBook Air 13.6"):
       the main hero image was rendering with sharp corners at desktop widths
       even though templates/product.json's media-gallery block has
       media_radius: 24 configured, and Horizon's own --media-radius-driven
       CSS (snippets/product-media.liquid) targets slideshow-container, not
       this .product-media-container wrapper. Reapplying the radius directly
       here, at the same value (24px), mirrors the mobile-only fix above and
       guarantees it renders regardless of that mismatch. */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container {
      border-radius: 24px !important;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .product-information__media .product-media-container :is(img, video, .deferred-media__poster-image) {
      border-radius: 24px !important;
    }

    /* CUSTOM FIX (2026-07-24, per Kalvis — round 2 on the same bug: the
       min-height:700px gate above stops the media column from stretching past
       the image's natural height on short viewports, but the radius/crop was
       still breaking on live window resize. Kalvis confirmed cross-browser
       behavior: Chrome only breaks resizing VERTICALLY ("once the window
       touches the image"); Safari breaks resizing in BOTH directions.
       Verified live (moistureoyster.com PDP, Claude in Chrome): forcing
       --constrained-height through every value from 835px down to 300px via
       the console, then re-measuring the rendered corner pixel-by-pixel with
       elementFromPoint, always traced a clean 24px arc — the border-radius/
       overflow-hidden math is correct both at rest and under a real (non-
       simulated) short-viewport resize. Combined with Safari breaking on
       ANY resize axis (not just height), this matches a known browser bug
       class rather than a CSS logic bug: overflow:hidden + border-radius on
       a box sized via calculated dimensions (aspect-ratio, calc(100vh -
       ...), flex/grid) can fail to re-clip to the new box on resize — a
       long-standing WebKit/Safari issue on virtually any resize, and a
       narrower Chromium variant tied to viewport-unit-driven recalculation
       specifically (matches "only breaks vertically" here, since only the
       height side of this box's sizing is vh-derived). contain:paint plus a
       forced compositing layer is the standard mitigation for this exact
       bug class — it pins the clip mask to the box's own paint so it's
       guaranteed to recomposite against the current box on every resize
       frame instead of depending on the browser's default repaint timing.
       Applied to both the slide box and slideshow-container (Horizon's own
       outer scroll-clip element, snippets/product-media.liquid) since both
       carry independent border-radius+overflow:hidden here; isolation:isolate
       added alongside translateZ(0) since Safari specifically needs an
       explicit stacking/paint context to reliably keep the clip in sync. Not
       yet reconfirmed with an actual live drag-resize in Safari specifically
       (out of reach of this session's tooling) — flag to Kalvis if it
       recurs there. */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container,
    #shopify-section-{{ section.id }} .product-information__media slideshow-container {
      contain: paint;
      isolation: isolate;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
    }
  }

  @media screen and (max-width: 749px) {
    /* CUSTOM: hero image follows the same side inset as the rest of the page
       content on mobile. Horizon's product-information-content snippet
       hardcodes the media column to grid-column: 1 / -1 on mobile (deliberate
       full-bleed-by-default), which we don't touch directly — overridden
       here instead to match .product-details' grid-column: 2 / 3. */
    #shopify-section-{{ section.id }} .product-information__media {
      grid-column: 2 / 3;
    }

    /* CUSTOM: mobile sticky add-to-cart bar drops the product name — doesn't fit
       alongside the image + subscribe-discount text + button in that compact a
       row. Desktop keeps it (untouched). .sticky-add-to-cart__info only wraps
       the title now (the variant-title row was removed entirely earlier). */
    #shopify-section-{{ section.id }} .sticky-add-to-cart__info {
      display: none;
    }

    /* CUSTOM: with the title/info column hidden above, nothing in the sticky bar's
       row was left to fill the space it used to flex:1 into — image and button
       are both fixed-width, so the row shrank to fit and sat flush left, leaving
       blank space on the right. Giving the discount text flex:1 (its old max-width
       cap no longer applies, that was sized to coexist with the title) makes it
       fill the gap and center within it, spacing image / text / button across the
       bar's full width. */
    #shopify-section-{{ section.id }} .sticky-add-to-cart__price {
      flex: 1;
      max-width: none;
      text-align: center;
    }

    /* CUSTOM: the outer .sticky-add-to-cart__price box above stays uncapped
       (flex:1, max-width:none) so it keeps filling/centering in the row gap —
       but that let the actual phrase wrap at the box's full width, fitting
       almost the whole sentence on line 1 and stranding "ORDER" alone on line
       2. Capping the width of the text itself (inline-block child, centered
       by the parent's text-align:center) forces an earlier, more balanced
       wrap without giving up the gap-filling behavior above. Per Kalvis
       (2026-07-18). This has to live in this inline style block, not the
       deduplicated stylesheet block further down this file — the
       deduplicated one compiles into the theme's shared head-loaded asset,
       which always loses equal-specificity ties to this section's own
       inline style tag (rendered later, in the body), regardless of source
       order within the file. */
    #shopify-section-{{ section.id }} .sticky-add-to-cart__price-label {
      display: inline-block;
      max-width: 8.5rem;
    }

    /* CUSTOM: product description mobile type spec (Kalvis) — same font-family/weight/color as
       desktop (set above), only size/line-height/letter-spacing differ at this breakpoint. */
    #shopify-section-{{ section.id }} .text-block--mo_description,
    #shopify-section-{{ section.id }} .text-block--mo_description :is(p, span, div, li, a) {
      font-size: 12px;
      line-height: 130%;
      letter-spacing: -0.02em;
    }

    /* CUSTOM: hero image crops to a 1:1 square on mobile.
       Desktop keeps aspect_ratio: adapt (each photo's natural ratio) — that
       setting lives in templates/product.json media-gallery block settings
       and is left untouched; this is a mobile-only visual override.
       CUSTOM FIX (2026-07-24, per Kalvis — radius unification pass): radius
       was 10px, visibly mismatched against the testimonial/buy-box cards
       stacked right below it on mobile (both 16px as of this same pass).
       Raised to 16px to match. Desktop's separate 24px value (below) is
       untouched — that's Figma's deliberate larger radius for the
       full-bleed gallery image, not part of this mismatch. */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container {
      aspect-ratio: 1 / 1 !important;
      border-radius: 16px !important;
      /* CUSTOM FIX (2026-07-24, per Kalvis): same compositor repaint-sync
         mitigation as the desktop block above — see that comment for the
         full root-cause writeup. Mobile viewport height changes on rotation/
         browser-chrome-collapse can trigger the same stale-clip paint glitch
         as a desktop window drag-resize. */
      contain: paint;
      isolation: isolate;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
    }

    #shopify-section-{{ section.id }} .product-information__media .product-media-container :is(img, video, .deferred-media__poster-image) {
      object-fit: cover !important;
      border-radius: 16px !important;
    }

    #shopify-section-{{ section.id }} .product-information__media slideshow-container {
      contain: paint;
      isolation: isolate;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      padding-block-start: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      padding-block: 10px;
      /* CUSTOM FIX (2026-07-27, per Kalvis): Horizon ships a small built-in
         inline padding here (~11.2px) that isn't touched by margin-inline:0
         above (margin and padding are independent) — it left the first
         thumbnail's left edge sitting ~11px right of the main image/other
         PDP elements' shared left edge (both at the page's mobile margin).
         Zeroing inline padding puts the thumbnail row flush with that same
         edge. */
      padding-inline-start: 0 !important;
      margin-block-start: 0 !important;
      margin-inline: 0 !important;
      justify-content: flex-start !important;
      align-self: flex-start !important;
      width: fit-content !important;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      justify-content: flex-start !important;
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      justify-content: flex-start !important;
      align-items: flex-start !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis): fixed 32x32 thumbnail size + 4px
       radius on mobile — was Horizon's native clamp(44px, 7vw, ...) sizing
       and the shared global 12px radius (see the un-scoped rule near the
       top of this file, which still governs any breakpoint this doesn't
       explicitly override). Overrides here since this rule is later in
       source order at the same specificity. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
      width: 32px !important;
      height: 32px !important;
      border-radius: 4px !important;
    }

    /* CUSTOM FIX (2026-07-27, per Kalvis — "almost a circle" report): the
       button's own border-radius above only clips via overflow:hidden on
       the BUTTON box — Horizon's native CSS (snippets/slideshow-controls.
       liquid) sets a SEPARATE border-radius directly on the <img> itself
       (var(--thumbnail-radius, var(--media-radius)), 12px here), and at a
       32px box that native 12px on the image reads as ~37% — nearly a full
       circle — regardless of the button's own radius. Matching the img's
       radius to 4px explicitly fixes the visible corner, not just the
       button's clip box. */
    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control img {
      border-radius: 4px !important;
    }

    /* CUSTOM: expert-quote testimonial appears above the hero image on
       mobile instead of below the buy box. Testimonial and buy box live in
       the same product-details container in Horizon's grid (not separate
       grid items), so a true CSS reorder isn't possible without invasive
       display:contents hacks — instead we render a second, independent
       testimonial block instance ("mobile-testimonial" in
       templates/product.json) inside the media capture below, and toggle
       which of the two shows per breakpoint. Keep both instances' copy in
       sync manually if edited in the theme editor. */
    #shopify-section-{{ section.id }} .product-details .mo-pdp-testimonial {
      display: none;
    }

    /* CUSTOM: mobile expert-quote testimonial — 10px gap to the hero image
       below it. Used to also force center-alignment + its own larger
       Manrope sizes here; removed per the 2026-07-22 redesign (Figma node
       1297:2331), which is left-aligned with its own 10px/9px type spec
       unified across breakpoints in blocks/mo-pdp-testimonial.liquid's own
       stylesheet — this file no longer needs to override it. */
    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial {
      margin-bottom: 10px;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial {
      display: none;
    }
  }
{% endstyle %}
<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture mobile_testimonial %}
  {%- content_for 'block',
    type: 'mo-pdp-testimonial',
    id: 'mobile-testimonial'
  -%}
{% endcapture %}

{% capture media_gallery %}
  {{- mobile_testimonial -}}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-custom-popover"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
      </div>

      {%- # CUSTOM: sticky bar shows only the Subscribe first-order discount callout, no dollar price at all (not tied to whichever quantity/purchase-option is selected in the picker above, which the shopper may have already scrolled past) — no variant title, per Kalvis. Renders nothing here if this variant has no selling plan at all. -%}
      {% liquid
        assign sticky_first_alloc = current_variant.selling_plan_allocations.first
        assign sticky_discount_pct = 0
        if sticky_first_alloc != blank and current_variant.price > sticky_first_alloc.price
          assign sticky_diff = current_variant.price | minus: sticky_first_alloc.price
          assign sticky_discount_pct = sticky_diff | times: 100.0 | divided_by: current_variant.price | round
        endif
      %}
      {% if sticky_first_alloc != blank %}
        <div
          class="sticky-add-to-cart__price"
          data-testid="sticky-price-display"
        >
          <span class="sticky-add-to-cart__price-label">
            {% if sticky_discount_pct > 0 %}
              Subscribe & save {{ sticky_discount_pct }}% on your first order
            {% else %}
              Subscribe & save on your first order
            {% endif %}
          </span>
        </div>
      {% endif %}

      {%- # CUSTOM: this button no longer adds to cart directly (removed the native on:click add-to-cart binding it used to have) — it just scrolls back up to the main buy box, since the sticky bar's fixed Subscribe price can't reflect whatever quantity/purchase-option the shopper has selected up there. See the scoped script right after this component for the scroll behavior. ref="addToCartButton" is kept (harmless, unused now) so sticky-add-to-cart.js's own internal ref lookups don't error. -%}
      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        data-mo-scroll-to-buybox
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>

  {%- # CUSTOM: scroll-to-buybox behavior for the sticky bar's button, replacing the native add-to-cart click it used to have (see the button markup above). UPSTREAM risk LOW — scoped to this one data attribute, no Horizon file touched. -%}
  <script>
    (function () {
      var btn = document.querySelector(
        '#shopify-section-{{ section.id }} [data-mo-scroll-to-buybox]'
      );
      if (!btn || btn.dataset.mounted === 'true') return;
      btn.dataset.mounted = 'true';

      btn.addEventListener('click', function () {
        var target = document.getElementById('shopify-section-{{ section.id }}');
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>
{% endif %}

{% render 'product-information-content',
  product: closest.product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    /* CUSTOM: was Horizon's native calc() token — matched to the same radius
       used site-wide for cards/buttons (mo-design-system.css --mo-radius-md),
       not the theme's default button-radius token. Per Kalvis (2026-07-18). */
    border-radius: var(--mo-radius-md, 10px);
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* CUSTOM: reskin the sticky bar's button with the same brand button (UI kit
     "Add to Bag +" / DeepGreen variant, Figma node 514-4994) already used on the
     main buybox's add-to-cart button below — was left on Horizon's generic
     .button styling (default theme color/radius/font), not the brand system.
     Kept the existing icon + "Add to cart" text/quantity structure (unlike the
     buybox button's ::after relabel trick) since this button isn't a
     content_for slot — no id-generation constraint here, just a plain custom
     element — and this markup already drives the mobile icon-only collapse,
     quantity badge, and "added" checkmark swap; only the visual skin changes.
     Per Kalvis (2026-07-18). UPSTREAM risk LOW — scoped selector, no Horizon
     file touched. */
  #shopify-section-{{ section.id }} .sticky-add-to-cart__button {
    background: var(--mo-deep-green, #093d24);
    color: var(--mo-white, #ffffff);
    border: none;
    border-radius: var(--mo-radius-md, 10px);
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sticky-add-to-cart__button:hover:not(:disabled) {
    background: var(--mo-green-mid, #115033);
  }

  #shopify-section-{{ section.id }} .sticky-add-to-cart__button:disabled {
    background: var(--mo-color-disabled, #9a9a9a);
    color: var(--mo-white, #ffffff);
    opacity: 0.85;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      /* CUSTOM: top corners only (flush with the screen's bottom edge) —
         matches the header nav's mobile corner radius (--mo-header-radius,
         set in custom-header.liquid) so the two fixed bars bookend the page
         with a consistent rounded look. Per Kalvis (2026-07-18). */
      border-radius: var(--mo-header-radius, 28px) var(--mo-header-radius, 28px) 0 0;

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  /* CUSTOM: reskin + relabel the native add-to-cart button as "Add to Bag +".
     Shopify's content_for 'block' slots inside buy-buttons.liquid (quantity /
     add-to-cart / accelerated-checkout) require the block TYPE to stay as the
     native type — swapping in a custom block type there fails theme
     validation ("Blocks are not allowed in this context"). So we keep the
     native `add-to-cart` block (see templates/product.json) and restyle +
     relabel it here instead. UPSTREAM risk LOW — scoped entirely to this
     section's submit button, no Horizon file touched.
     CUSTOM: uses an id-prefix attribute selector, not a literal full id —
     Horizon builds this id as 'BuyButtons-ProductSubmitButton-' + the native
     add-to-cart child block's own id (e.g. '...-AY1RFNmphTmpnRjViZ__add-to-cart'),
     which is Shopify-editor-generated and can change any time a merchant
     touches this block in the theme editor. A hardcoded '...-add-to-cart' id
     match silently stops working the moment that id regenerates (confirmed
     live — the reskin wasn't applying and the plain native button was
     showing through). The prefix match is immune to that. */
  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
    width: 100%;
    background: var(--mo-deep-green, #093d24);
    color: var(--mo-white, #ffffff);
    border: none;
    border-radius: var(--mo-radius-md, 10px); /* CUSTOM: was --mo-radius-sm (6px) — Figma dev-mode confirms 10px, matching the site-wide button radius (audit #29, 2026-07-17) */
    padding: 10px 30px; /* CUSTOM: was 16px/24px — Figma confirms 10px vertical / 30px horizontal for this button */
    font-family: var(--mo-font-mono, 'IBM Plex Mono', monospace);
    font-weight: 500;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase !important;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-']:hover:not(:disabled) {
    background: var(--mo-green-mid, #115033);
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-icon {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text__content {
    display: none;
  }

  #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] .add-to-cart-text::after {
    content: 'Add to Bag +';
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} [id^='BuyButtons-ProductSubmitButton-'] {
      font-size: 12px;
    }
  }

  /* CUSTOM: hide Seal Subscriptions' own injected widget — we render our own
     Subscribe/One-time UI in mo-tier-picker and only use Seal for the
     underlying native selling plans, not its default storefront widget.
     UPSTREAM risk LOW — scoped selector, no Horizon file touched. */
  .sealsubs-target-element {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MO Product Information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Not used — see Top padding (mobile / desktop) below instead."
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Not used — see Bottom padding (mobile / desktop) below instead."
    },
    {
      "type": "header",
      "content": "Top padding"
    },
    {
      "type": "range",
      "id": "mo_top_padding_mobile",
      "label": "Space above section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the gallery/buy-box position inside this section."
    },
    {
      "type": "range",
      "id": "mo_top_padding_desktop",
      "label": "Space above section — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Gap above this section only — doesn't affect the gallery/buy-box position inside this section."
    },
    {
      "type": "header",
      "content": "Bottom padding"
    },
    {
      "type": "range",
      "id": "mo_bottom_padding_mobile",
      "label": "Space after section — mobile",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 60,
      "info": "Gap to the next section only — doesn't affect the gallery/buy-box position inside this section."
    },
    {
      "type": "range",
      "id": "mo_bottom_padding_desktop",
      "label": "Space after section — desktop",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80,
      "info": "Gap to the next section only — doesn't affect the gallery/buy-box position inside this section."
    }
  ],
  "presets": []
}
{% endschema %}
