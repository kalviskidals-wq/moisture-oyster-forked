{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}

{%- # CUSTOM: hero gallery thumbnail overlay per hero-image design spec. Horizon's native thumbnails-style controls hardcode controls_on_media to false (see snippets/product-media-gallery-content.liquid), so an on-image floating rail isn't reachable via block settings alone — this scoped override achieves it with CSS instead. Uses the non-deduplicated inline style tag (not the deduplicated stylesheet tag) specifically because the deduplicated one is shared theme-wide and can't be scoped with the section id — see feedback-shopify-theme-validation-gotchas memory. UPSTREAM risk LOW — scoped entirely to this section's shopify-section wrapper id, no Horizon file touched. -%}
{% style %}
  /* Force thumbnails to a 1:1 box regardless of each photo's native aspect ratio. Main slides keep aspect_ratio: adapt (their own natural ratio) untouched — that setting lives in templates/product.json media-gallery block settings. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control {
    aspect-ratio: 1 / 1 !important;
  }

  /* First thumbnail duplicates the main hero image already showing, so it's hidden rather than removed from the loop (that loop lives in the native slideshow-controls snippet, which we don't touch). */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control:first-child {
    display: none;
  }

  /* No border/outline on the active thumbnail, per design. */
  #shopify-section-{{ section.id }} .slideshow-controls__thumbnails .slideshow-control[aria-selected='true'] {
    outline: none;
    border: none;
  }

  /* No prev/next arrows over the main image. */
  #shopify-section-{{ section.id }} slideshow-arrows {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .media-gallery--carousel {
      position: relative;
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      position: absolute;
      left: 30px;
      bottom: 30px;
      top: auto;
      transform: none;
      flex-direction: column;
      width: auto;
      height: auto;
      max-height: calc(100% - 60px);
      z-index: var(--layer-raised, 2);
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      width: auto;
      max-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      flex-direction: column;
      margin: 0;
      padding: 0;
      gap: var(--gap-xs, 8px);
    }
  }

  @media screen and (max-width: 749px) {
    /* CUSTOM: hero image follows the same side inset as the rest of the page
       content on mobile. Horizon's product-information-content snippet
       hardcodes the media column to grid-column: 1 / -1 on mobile (deliberate
       full-bleed-by-default), which we don't touch directly — overridden
       here instead to match .product-details' grid-column: 2 / 3. */
    #shopify-section-{{ section.id }} .product-information__media {
      grid-column: 2 / 3;
    }

    /* CUSTOM: hero image crops to a 1:1 square with a 10px radius on mobile.
       Desktop keeps aspect_ratio: adapt (each photo's natural ratio) — that
       setting lives in templates/product.json media-gallery block settings
       and is left untouched; this is a mobile-only visual override. */
    #shopify-section-{{ section.id }} .product-information__media .product-media-container {
      aspect-ratio: 1 / 1 !important;
      border-radius: 10px !important;
    }

    #shopify-section-{{ section.id }} .product-information__media .product-media-container :is(img, video, .deferred-media__poster-image) {
      object-fit: cover !important;
      border-radius: 10px !important;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      padding-block-start: 0;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails {
      padding-block: 10px;
      margin-block-start: 0 !important;
      margin-inline: 0 !important;
      justify-content: flex-start !important;
      align-self: flex-start !important;
      width: fit-content !important;
    }

    #shopify-section-{{ section.id }} .slideshow-controls__thumbnails-container {
      justify-content: flex-start !important;
      width: 100% !important;
    }

    #shopify-section-{{ section.id }} slideshow-controls[thumbnails][pagination-position='center'] {
      justify-content: flex-start !important;
      align-items: flex-start !important;
    }

    /* CUSTOM: expert-quote testimonial appears above the hero image on
       mobile instead of below the buy box. Testimonial and buy box live in
       the same product-details container in Horizon's grid (not separate
       grid items), so a true CSS reorder isn't possible without invasive
       display:contents hacks — instead we render a second, independent
       testimonial block instance ("mobile-testimonial" in
       templates/product.json) inside the media capture below, and toggle
       which of the two shows per breakpoint. Keep both instances' copy in
       sync manually if edited in the theme editor. */
    #shopify-section-{{ section.id }} .product-details .mo-pdp-testimonial {
      display: none;
    }

    /* CUSTOM: mobile expert-quote testimonial — 10px gap to the hero image
       below it, center-aligned, and specific Manrope type sizes per design
       spec. Scoped to .product-information__media so only the mobile
       instance is affected; the desktop instance (in .product-details)
       keeps its original left-aligned styling. */
    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial {
      margin-bottom: 10px;
      align-items: center;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial__rating {
      justify-content: center;
      font-family: var(--mo-font-heading, 'Manrope', sans-serif);
      font-weight: 800;
      font-size: 14px;
      line-height: 14.68px;
      letter-spacing: 0;
    }

    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial__author {
      font-family: var(--mo-font-heading, 'Manrope', sans-serif);
      font-weight: 700;
      font-size: 12px;
      line-height: 130%;
      letter-spacing: 0;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial__quote {
      font-family: var(--mo-font-heading, 'Manrope', sans-serif);
      font-weight: 500;
      font-size: 10px;
      line-height: 130%;
      letter-spacing: -0.02em;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product-information__media .mo-pdp-testimonial {
      display: none;
    }
  }
{% endstyle %}
