{%- # CUSTOM (2026-07-18: review card removed per Kalvis): net-new theme section — PDP "Subscription Deep-Dive": post-reviews subscription pitch with three reasons recurring delivery wins, framed as a supported programme. Desktop: eyebrow/heading overlay top-left directly on a full-bleed lifestyle image, benefit cards stack in a column on the right. Mobile: eyebrow/heading render first in a solid light block above the image (not overlaid — same position:absolute→static breakpoint switch as .mo-problem__header in custom-problem-agitation.liquid), then a horizontal scroll-snap benefit-card carousel overlays the bottom of the image. UPSTREAM risk LOW — net-new, no Horizon file touched. -%}
{%- # CUSTOM: load design tokens + the .mo-sub-benefits / .mo-icon-card rules here (not layout/theme.liquid) since site-wide inclusion is still pending approval. Every mo-* element also ships hardcoded var() fallbacks so this still renders correctly if either tag is ever removed. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}
{{ 'custom.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign has_video = false
  if s.background_video != blank
    assign has_video = true
  endif
  assign has_poster = false
  if s.background_image != blank
    assign has_poster = true
  endif
  assign has_poster_mobile = false
  if s.background_image_mobile != blank
    assign has_poster_mobile = true
  endif
-%}

<section
  class="mo-sub-benefits"
  id="MoSubBenefits-{{ section.id }}"
  style="
    --mo-sub-header-bg: {{ s.header_background_color | default: '#BAB9BE' }};
    --mo-sub-eyebrow: {{ s.eyebrow_color | default: '#1FA567' }};
    --mo-sub-heading: {{ s.heading_color | default: '#093D24' }};
    --mo-sub-scrim: {{ s.scrim_color | default: '#093D24' }};
    --mo-sub-scrim-opacity: {{ s.scrim_opacity | default: 0 | divided_by: 100.0 }};
    --mo-icon-card-bg: {{ s.card_background_color | default: '#093D24' }};
    --mo-icon-card-radius: {{ s.card_radius | default: 16 }}px;
    --mo-icon-card-icon: {{ s.icon_color | default: '#FFD5F7' }};
    --mo-icon-card-title: {{ s.title_color | default: '#FFFFFF' }};
    --mo-icon-card-desc: {{ s.description_color | default: '#FFFFFF' }};
    --mo-sub-padding-y: {{ s.vertical_padding | default: 40 }}px;
    --mo-sub-radius: {{ s.section_radius | default: 20 }}px;
    --mo-sub-inset: {{ s.section_inset | default: 16 }}px;
  "
>
  <div class="mo-sub-benefits__header">
    {%- if s.eyebrow != blank -%}
      <p class="mo-sub-benefits__eyebrow mo-tag">{{ s.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="mo-sub-benefits__heading mo-h2">{{ s.heading | newline_to_br }}</h2>
    {%- endif -%}
  </div>

  <div class="mo-sub-benefits__media">
    {%- if has_poster -%}
      {%- comment -%}
        CUSTOM (2026-07-20, per Kalvis): mobile can use a different
        background image than desktop. When a mobile-specific image is
        set, this desktop image gets the `--desktop-only` modifier
        (hidden below 750px, see custom.css) and the mobile-specific
        image below takes over; when no mobile image is set, this image
        has no modifier and stays visible at all widths (fallback).
      {%- endcomment -%}
      {%- liquid
        assign poster_class = 'mo-sub-benefits__poster'
        if has_poster_mobile
          assign poster_class = poster_class | append: ' mo-sub-benefits__poster--desktop-only'
        endif
      -%}
      {{
        s.background_image
        | image_url: width: 1600
        | image_tag:
          width: s.background_image.width,
          height: s.background_image.height,
          alt: s.background_image.alt,
          sizes: '100vw',
          class: poster_class,
          loading: 'lazy',
          fetchpriority: 'low'
      }}
    {%- endif -%}

    {%- if has_poster_mobile -%}
      {{
        s.background_image_mobile
        | image_url: width: 1600
        | image_tag:
          width: s.background_image_mobile.width,
          height: s.background_image_mobile.height,
          alt: s.background_image_mobile.alt,
          sizes: '100vw',
          class: 'mo-sub-benefits__poster mo-sub-benefits__poster--mobile-only',
          loading: 'lazy',
          fetchpriority: 'low'
      }}
    {%- endif -%}

    {%- if has_video -%}
      <div class="mo-sub-benefits__video-wrap">
        {{
          s.background_video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            playsinline: true,
            preload: 'auto',
            class: 'mo-sub-benefits__video',
            data-testid: 'subscribe-benefits-video'
        }}
      </div>
    {%- endif -%}

    <div class="mo-sub-benefits__scrim" aria-hidden="true"></div>

    <div class="mo-sub-benefits__overlay">
      {%- if section.blocks.size > 0 -%}
        <div class="mo-sub-benefits__benefits" role="list" aria-label="{{ s.eyebrow | strip_newlines | escape }}">
          {%- # CUSTOM (2026-07-20, per Kalvis): mobile-only leading spacer, mirrors the trailing one below — matches .mo-eye-health__cards-spacer exactly. scroll-padding-inline-start (see custom.css) gives every card the same 20px gap once the carousel has been scrolled/snapped at least once, but the very first paint — before any scroll/snap event has run — just uses the raw scrollLeft:0 default, which this spacer alone provides the gap for. -%}
          <div class="mo-sub-benefits__benefits-spacer" aria-hidden="true"></div>
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              {%- liquid
                assign bs = block.settings
                assign has_icon = false
                if bs.icon_image != blank
                  assign has_icon = true
                elsif bs.icon_preset != 'none'
                  assign has_icon = true
                endif
              -%}
              {%- capture icon_markup -%}
                {%- if bs.icon_image != blank -%}
                  {{
                    bs.icon_image
                    | image_url: width: 64
                    | image_tag:
                      width: 32,
                      height: 32,
                      loading: 'lazy',
                      alt: '',
                      class: 'mo-icon-card__icon-img'
                  }}
                {%- elsif has_icon -%}
                  {%- render 'mo-subscribe-icon', icon: bs.icon_preset -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- render 'mo-icon-card',
                icon_html: icon_markup,
                title: bs.title,
                description: bs.description,
                extra_class: 'mo-sub-benefits__card',
                list_item: true,
                shopify_attributes: block.shopify_attributes
              -%}
            {%- endif -%}
          {%- endfor -%}
          <div class="mo-sub-benefits__benefits-spacer" aria-hidden="true"></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MO Subscribe Benefits",
  "tag": "section",
  "class": "mo-sub-benefits-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SUBSCRIBE & SAVE"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Why subscribers love it more"
    },
    {
      "type": "header",
      "content": "Background media (full-bleed)"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Always-present base layer — lifestyle photo. Shown alone if no video is set, and whenever the visitor's device has reduced motion enabled."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Overrides the background image above on mobile only. Leave blank to reuse the same image on mobile."
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Optional, included for consistency with other PDP sections. Autoplays muted, looped, no controls. Falls back to the background image above if left blank — this frame shows an image, not a video."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "header_background_color",
      "label": "Section / mobile header background",
      "default": "#BAB9BE",
      "info": "Confirmed by Kalvis (2026-07-10)."
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#1FA567"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#093D24"
    },
    {
      "type": "color",
      "id": "scrim_color",
      "label": "Image/video scrim color",
      "default": "#093D24",
      "info": "Solid overlay for legibility. Defaults to 0% opacity since the review card and benefit cards already carry their own opaque backgrounds — raise it only if a merchant swaps in a busier photo."
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Image/video scrim opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Benefit card background",
      "default": "#093D24"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Benefit icon color",
      "default": "#FFD5F7"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Benefit title color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Benefit description color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Benefit card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_radius",
      "label": "Section corner radius",
      "info": "Rounds the whole section. A small side inset is added so the rounding is actually visible (a full-bleed, edge-to-edge box has nowhere for a radius to show against) — see the section_inset setting below.",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_inset",
      "label": "Side inset (reveals the corner radius)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Extra section vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Built-in icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "frequency", "label": "Frequency (document/list)" },
            { "value": "delivery", "label": "Delivery (box)" },
            { "value": "guide", "label": "Guide (heart)" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Overrides the built-in icon above if set."
        },
        {
          "type": "header",
          "content": "Copy"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Add description here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MO Subscribe Benefits",
      "category": "Custom",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_preset": "frequency",
            "title": "Choose your frequency",
            "description": "After your first order we send a guide to building a daily eye care habit."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_preset": "delivery",
            "title": "Free delivery, always",
            "description": "Every subscription ships free across the US. No threshold, no conditions."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_preset": "guide",
            "title": "Your eye care guide",
            "description": "After your first order we send a guide to building a daily eye care habit."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
