{%- # CUSTOM: net-new theme section — PDP "Ingredient Transparency" data sheet. White rounded card (on the deep-green page bg) with a hydrating-gel video/poster on the left (desktop) and, on the right, an eyebrow + heading followed by a 4-tab data sheet (Active / Inactive / Free From / Specs). Active + Inactive tabs render repeatable ingredient accordions (number pill, name, subtitle, up to 5 label/value detail rows); Free From renders a flat title+description list; Specs renders a flat metric/value list. Tabs + accordions both work without JS (all 4 panels render stacked in the DOM; native <details>/<summary> handles expand/collapse) — assets/mo-tabs.js progressively enhances the tablist into a real ARIA tablist with roving tabindex + arrow-key nav and hides inactive panels. UPSTREAM risk LOW — no Horizon file touched. -%}
{%- # CUSTOM: load design tokens + the .mo-ingredients rules here (not layout/theme.liquid) since site-wide inclusion is still pending approval. Every mo-* element also ships hardcoded var() fallbacks so this still renders correctly if either tag is ever removed. -%}
{{ 'mo-design-system.css' | asset_url | stylesheet_tag }}
{{ 'custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mo-tabs.js' | asset_url }}" type="module"></script>

{%- liquid
  assign s = section.settings
  assign has_video = false
  if s.video_background != blank
    assign has_video = true
  endif
  assign has_poster = false
  if s.poster_image != blank
    assign has_poster = true
  endif
  assign show_video_mobile = false
  if s.show_video_mobile
    assign show_video_mobile = true
  endif
-%}

<section
  class="mo-ingredients"
  id="MoIngredients-{{ section.id }}"
  data-show-video-mobile="{{ show_video_mobile }}"
  style="
    --mo-ingredients-bg: {{ s.background_color | default: '#093D24' }};
    --mo-ingredients-card-bg: {{ s.card_background_color | default: '#FFFFFF' }};
    --mo-ingredients-radius: {{ s.card_radius | default: 16 }}px;
    --mo-ingredients-eyebrow: {{ s.eyebrow_color | default: '#1FA567' }};
    --mo-ingredients-heading: {{ s.heading_color | default: '#093D24' }};
    --mo-ingredients-tab-border: {{ s.tab_color | default: '#1FA567' }};
    --mo-ingredients-tab-text: {{ s.tab_color | default: '#1FA567' }};
    --mo-ingredients-tab-active-bg: {{ s.tab_active_color | default: '#1FA567' }};
    --mo-ingredients-tab-active-text: {{ s.tab_active_text_color | default: '#FFFFFF' }};
    --mo-ingredients-number-bg: {{ s.number_pill_color | default: '#FFD5F7' }};
    --mo-ingredients-toggle-open-bg: {{ s.toggle_open_color | default: '#E7F5EC' }};
    --mo-ingredients-divider: {{ s.divider_color | default: '#1FA567' }};
    --mo-ingredients-padding-y: {{ s.vertical_padding | default: 40 }}px;
  "
>
  <div class="mo-ingredients__inner">
    <div class="mo-ingredients__card">
      {%- # CUSTOM (2026-07-09, layout fix): eyebrow + heading live in the LEFT column with the media, per the actual Figma reference (the master prompt's text description said eyebrow/heading go with the tabs on the right, but the provided frames clearly show them stacked above a bounded, non-full-bleed video box on the left — went with what the frames show). Tabs + panels are the entire right column. -%}
      <div class="mo-ingredients__media-col">
        {%- if s.eyebrow != blank -%}
          <p class="mo-ingredients__eyebrow mo-tag">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="mo-ingredients__heading mo-h2">{{ s.heading | newline_to_br }}</h2>
        {%- endif -%}
        {%- if has_video or has_poster -%}
          <div class="mo-ingredients__media">
            {%- if has_poster -%}
              {{
                s.poster_image
                | image_url: width: 900
                | image_tag:
                  width: s.poster_image.width,
                  height: s.poster_image.height,
                  alt: s.poster_image.alt,
                  sizes: '(min-width: 750px) 40vw, 100vw',
                  class: 'mo-ingredients__poster',
                  loading: 'lazy'
              }}
            {%- endif -%}
            {%- if has_video -%}
              <div class="mo-ingredients__video-wrap">
                {{
                  s.video_background
                  | video_tag:
                    poster: nil,
                    autoplay: true,
                    loop: true,
                    controls: false,
                    muted: true,
                    playsinline: true,
                    preload: 'auto',
                    class: 'mo-ingredients__video',
                    data-testid: 'ingredient-transparency-video'
                }}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mo-ingredients__content">
        <mo-tabs class="mo-ingredients__tabs">
          <div class="mo-ingredients__tablist" role="tablist" aria-label="{{ s.heading | strip_newlines | escape }}">
            {%- liquid
              assign label_1 = s.tab_1_label | default: 'ACTIVE'
              assign label_2 = s.tab_2_label | default: 'INACTIVE'
              assign label_3 = s.tab_3_label | default: 'FREE FROM'
              assign label_4 = s.tab_4_label | default: 'SPECS'
              assign tab_labels_joined = label_1 | append: '||' | append: label_2 | append: '||' | append: label_3 | append: '||' | append: label_4
              assign tab_labels = tab_labels_joined | split: '||'
            -%}
            {%- for tab_label in tab_labels -%}
              {%- liquid
                assign tab_index = forloop.index
                assign tab_id = 'MoIngredientsTab-' | append: section.id | append: '-' | append: tab_index
                assign panel_id = 'MoIngredientsPanel-' | append: section.id | append: '-' | append: tab_index
                assign is_first = false
                if forloop.first
                  assign is_first = true
                endif
              -%}
              <button
                type="button"
                class="mo-ingredients__tab{% if is_first %} is-active{% endif %}"
                id="{{ tab_id }}"
                role="tab"
                aria-selected="{{ is_first }}"
                aria-controls="{{ panel_id }}"
                tabindex="{% if is_first %}0{% else %}-1{% endif %}"
              >
                {{ tab_label | escape }}
              </button>
            {%- endfor -%}
          </div>

          <div class="mo-ingredients__panels">
            {%- comment -%} Panel 1 — Active ingredients {%- endcomment -%}
            <section
              class="mo-ingredients__panel"
              id="MoIngredientsPanel-{{ section.id }}-1"
              role="tabpanel"
              aria-labelledby="MoIngredientsTab-{{ section.id }}-1"
              tabindex="0"
            >
              <h3 class="visually-hidden">{{ tab_labels[0] | escape }}</h3>
              {%- for block in section.blocks -%}
                {%- if block.type == 'ingredient' and block.settings.tab == '1' -%}
                  {%- render 'mo-ingredient-item', block: block, section: section -%}
                {%- endif -%}
              {%- endfor -%}
            </section>

            {%- comment -%} Panel 2 — Inactive ingredients {%- endcomment -%}
            <section
              class="mo-ingredients__panel"
              id="MoIngredientsPanel-{{ section.id }}-2"
              role="tabpanel"
              aria-labelledby="MoIngredientsTab-{{ section.id }}-2"
              tabindex="0"
            >
              <h3 class="visually-hidden">{{ tab_labels[1] | escape }}</h3>
              {%- for block in section.blocks -%}
                {%- if block.type == 'ingredient' and block.settings.tab == '2' -%}
                  {%- render 'mo-ingredient-item', block: block, section: section -%}
                {%- endif -%}
              {%- endfor -%}
            </section>

            {%- comment -%} Panel 3 — Free From {%- endcomment -%}
            <section
              class="mo-ingredients__panel"
              id="MoIngredientsPanel-{{ section.id }}-3"
              role="tabpanel"
              aria-labelledby="MoIngredientsTab-{{ section.id }}-3"
              tabindex="0"
            >
              <h3 class="visually-hidden">{{ tab_labels[2] | escape }}</h3>
              <div class="mo-free-from">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'free_from' and block.settings.tab == '3' and block.settings.title != blank -%}
                    <div class="mo-free-from__item" {{ block.shopify_attributes }}>
                      <p class="mo-free-from__title mo-h4">{{ block.settings.title | escape }}</p>
                      {%- if block.settings.description != blank -%}
                        <p class="mo-free-from__desc mo-body-lg">{{ block.settings.description | escape }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </section>

            {%- comment -%} Panel 4 — Specs {%- endcomment -%}
            <section
              class="mo-ingredients__panel"
              id="MoIngredientsPanel-{{ section.id }}-4"
              role="tabpanel"
              aria-labelledby="MoIngredientsTab-{{ section.id }}-4"
              tabindex="0"
            >
              <h3 class="visually-hidden">{{ tab_labels[3] | escape }}</h3>
              <div class="mo-specs">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'spec' and block.settings.tab == '4' and block.settings.label != blank -%}
                    <div class="mo-specs__row" {{ block.shopify_attributes }}>
                      <span class="mo-specs__label mo-menu">{{ block.settings.label | escape }}</span>
                      <span class="mo-specs__value mo-body-lg">{{ block.settings.value | escape }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </section>
          </div>
        </mo-tabs>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
